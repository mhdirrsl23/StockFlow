<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <!-- Topbar tab utama -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="66dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SF.Text.Title"
                android:singleLine="true"
                android:text="Laporan"
                android:textSize="18sp" />

            <TextView
                style="@style/SF.Text.Caption"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:text="Stok, mutasi &amp; audit" />
        </LinearLayout>

        <!-- Notifikasi + badge -->
        <FrameLayout
            android:id="@+id/btn_notifikasi_laporan"
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                style="@style/SF.IconBtn"
                android:src="@drawable/ic_bell" />

            <TextView
                android:id="@+id/tv_badge_notif_laporan"
                style="@style/SF.Text"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/sf_on_brand"
                android:textSize="8sp" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Tab laporan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segmented"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/tab_laporan_stok"
                    style="@style/SF.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:singleLine="true"
                    android:text="Stok"
                    android:textColor="@color/sf_brand"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tab_laporan_mutasi"
                    style="@style/SF.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:singleLine="true"
                    android:text="Mutasi"
                    android:textColor="#6E8277"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tab_laporan_kedaluwarsa"
                    style="@style/SF.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:singleLine="true"
                    android:text="Kedaluwarsa"
                    android:textColor="#6E8277"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tab_laporan_aktivitas"
                    style="@style/SF.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="2dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:singleLine="true"
                    android:text="Aktivitas"
                    android:textColor="#6E8277"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Ringkasan 3 metrik -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_barang_aktif"
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="0" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="barang aktif" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_unit_tersedia"
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="0" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="unit tersedia" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_stok_menipis"
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="0"
                        android:textColor="@color/sf_warn" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="stok menipis" />
                </LinearLayout>
            </LinearLayout>

            <!-- Header + CSV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="31dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.Section"
                        android:text="Stok tersedia" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="3dp"
                        android:text="Stok tersedia · batch kedaluwarsa &amp; ditangani tidak dihitung" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_export_csv"
                    style="@style/SF.Btn.Ghost"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:drawableStart="@drawable/ic12_download"
                    android:paddingHorizontal="12dp"
                    android:text="CSV"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- RecyclerView untuk Daftar Stok Laporan -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_laporan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_barang" />

            <!-- csv-note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_info"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginStart="4dp"
                    android:text="Total unit menjumlahkan satuan berbeda (pcs, box, pack); bukan nilai uang — skema tidak punya kolom harga."
                    android:textColor="@color/sf_muted_2" />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>

</LinearLayout>