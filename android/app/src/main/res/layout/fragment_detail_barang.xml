<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Detail barang"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btn_hapus_barang"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_more_v" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/bg_icon_detail"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_product_home">

                    <ImageView
                        android:id="@+id/iv_icon_detail"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_droplet"
                        app:tint="#397A55" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_nama_barang"
                        style="@style/SF.Text.Title"
                        android:lineSpacingMultiplier="1.05"
                        android:text="Sunlight 755ml" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp">

                        <TextView
                            android:id="@+id/meta_sku"
                            style="@style/SF.Text.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SKU-RMH-001"
                            android:textColor="@color/sf_muted"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/meta_dot1"
                            style="@style/SF.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="·" />

                        <TextView
                            android:id="@+id/meta_kategori"
                            style="@style/SF.Pill.Outline"
                            android:text="Kebutuhan Rumah" />

                        <TextView
                            android:id="@+id/meta_dot2"
                            style="@style/SF.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="·" />

                        <TextView
                            android:id="@+id/meta_satuan"
                            style="@style/SF.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="pcs"
                            android:textSize="11sp" />

                        <androidx.constraintlayout.helper.widget.Flow
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="meta_sku,meta_dot1,meta_kategori,meta_dot2,meta_satuan"
                            app:flow_horizontalBias="0"
                            app:flow_horizontalGap="6dp"
                            app:flow_horizontalStyle="packed"
                            app:flow_verticalGap="5dp"
                            app:flow_wrapMode="chain"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/banner_stok_minimum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert_warn"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_alert_circle"
                    app:tint="@color/sf_warn_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Stok di bawah minimum."
                        android:textColor="@color/sf_warn_ink"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_desc_stok_minimum"
                        style="@style/SF.Text"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="Segera catat stok masuk jika persediaan menipis."
                        android:textColor="@color/sf_warn_ink"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_tint"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SF.Text.Eyebrow"
                            android:text="Stok tersedia" />

                        <TextView
                            android:id="@+id/tv_total_stok"
                            style="@style/SF.Text"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:letterSpacing="-0.03"
                            android:text="5 pcs"
                            android:textColor="@color/sf_ink"
                            android:textSize="26sp" />

                        <TextView
                            android:id="@+id/tv_stok_minimum"
                            style="@style/SF.Text.Caption"
                            android:layout_marginTop="5dp"
                            android:text="Minimum 15 pcs" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_badge_status_detail"
                        style="@style/SF.Pill.Warn"
                        android:layout_marginStart="10dp"
                        android:drawableStart="@drawable/ic12_alert_triangle"
                        android:text="Stok Menipis" />
                </LinearLayout>

                <TextView
                    style="@style/SF.Text.Muted"
                    android:layout_marginTop="9dp"
                    android:text="Batch kedaluwarsa dan ditangani tidak dihitung ke total stok tersedia." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.Section"
                        android:text="Batch stok" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="3dp"
                        android:text="Urut FEFO (kedaluwarsa terdekat)" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_link_tambah_batch"
                    style="@style/SF.Text.Link"
                    android:drawableEnd="@drawable/ic12_plus"
                    android:text="Tambah"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="2dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_batch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_batch" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:paddingHorizontal="2dp">

                <TextView
                    style="@style/SF.Text.Section"
                    android:text="Informasi barang" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="3dp"
                    android:text="Kolom tabel barang" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingHorizontal="15dp"
                android:paddingVertical="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="ID barang" />

                    <TextView
                        android:id="@+id/tv_info_id"
                        style="@style/SF.Text.Mono"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="#-"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Kode SKU" />

                    <TextView
                        android:id="@+id/tv_info_sku"
                        style="@style/SF.Text.Mono"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="-"
                        android:textStyle="bold" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Kategori" />

                    <TextView
                        android:id="@+id/tv_info_kategori"
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="-" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Satuan" />

                    <TextView
                        android:id="@+id/tv_info_satuan"
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="-" />
                </LinearLayout>

                <View style="@style/SF.Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="9dp">

                    <TextView
                        style="@style/SF.Text.Muted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.42"
                        android:text="Stok minimum" />

                    <TextView
                        android:id="@+id/tv_info_minimum"
                        style="@style/SF.Text.Strong"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="0.58"
                        android:gravity="end"
                        android:text="-" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SF.Text.Caption"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic12_database"
                android:drawablePadding="4dp"
                android:drawableTint="@color/sf_muted_2"
                android:gravity="center_vertical"
                android:paddingHorizontal="2dp"
                android:text="Sumber: tabel barang · view v_stok_tersedia"
                android:textColor="@color/sf_muted_2" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_actionbar"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <TextView
            android:id="@+id/btn_stok_keluar"
            style="@style/SF.Btn.Ghost"
            android:layout_width="0dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic12_arrow_up_right"
            android:text="Stok keluar" />

        <TextView
            android:id="@+id/btn_tambah_batch"
            style="@style/SF.Btn.Primary"
            android:layout_width="0dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic12_plus"
            android:text="Tambah batch" />
    </LinearLayout>
</LinearLayout>