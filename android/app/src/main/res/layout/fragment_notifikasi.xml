<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back_notifikasi"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Notifikasi"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btn_mark_all_read"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_check_circle" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Ringkasan belum dibaca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text.Eyebrow"
                        android:text="Notifikasi hari ini" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_count_unread"
                            style="@style/SF.Text"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:letterSpacing="-0.03"
                            android:text="0"
                            android:textColor="@color/sf_ink"
                            android:textSize="26sp" />

                        <TextView
                            style="@style/SF.Text"
                            android:layout_marginStart="5dp"
                            android:paddingBottom="3dp"
                            android:text="belum dibaca"
                            android:textColor="@color/sf_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ic_warn">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/sf_warn" />
                </FrameLayout>
            </LinearLayout>

            <!-- Chip filter -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="1dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:id="@+id/chip_notif_semua"
                        style="@style/SF.Chip.Active"
                        android:text="Semua" />

                    <TextView
                        android:id="@+id/chip_notif_mendekati"
                        style="@style/SF.Chip"
                        android:layout_marginStart="7dp"
                        android:text="Mendekati" />

                    <TextView
                        android:id="@+id/chip_notif_kedaluwarsa"
                        style="@style/SF.Chip"
                        android:layout_marginStart="7dp"
                        android:text="Kedaluwarsa" />

                    <TextView
                        android:id="@+id/chip_notif_menipis"
                        style="@style/SF.Chip"
                        android:layout_marginStart="7dp"
                        android:text="Stok Menipis" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- RecyclerView untuk Daftar Notifikasi -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_notifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_barang" />

            <!-- State kosong jika tidak ada notifikasi -->
            <LinearLayout
                android:id="@+id/empty_state_notifikasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_empty"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ic_safe">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic12_check_circle"
                        app:tint="@color/sf_safe" />
                </FrameLayout>

                <TextView
                    style="@style/SF.Text.Strong"
                    android:layout_marginTop="9dp"
                    android:text="Tidak ada notifikasi" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Semua pemberitahuan sistem sudah bersih." />
            </LinearLayout>

            <!-- Info penjadwal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert_info"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_calendar_clock"
                    app:tint="@color/sf_info_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Dibuat penjadwal Laravel."
                        android:textColor="@color/sf_info_ink"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.35"
                        android:text="Pukul 06.00 $amp; 18.00 WIB, lalu dibaca WorkManager tiap 12 jam."
                        android:textColor="@color/sf_info_ink"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Catatan sumber -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginStart="6dp"
                    android:text="Sumber: notifikasi · semua belum ditampilkan" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>