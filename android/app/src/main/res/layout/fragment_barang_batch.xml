<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="66dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SF.Text.Title"
                android:singleLine="true"
                android:text="Barang"
                android:textSize="18sp" />

            <TextView
                style="@style/SF.Text.Caption"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:text="Master barang &amp; batch stok" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_tambah_batch_top"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_plus" />

        <FrameLayout
            android:id="@+id/btn_notifikasi"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp">

            <ImageView
                style="@style/SF.IconBtn"
                android:src="@drawable/ic_bell" />

            <TextView
                android:id="@+id/tv_badge_notif"
                style="@style/SF.Text"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/sf_on_brand"
                android:textSize="8sp" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segmented"
                android:orientation="horizontal"
                android:padding="3dp">

                <LinearLayout
                    android:id="@+id/tab_barang"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_box"
                        app:tint="#6C8176" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Barang"
                        android:textColor="#6C8176"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_count_tab_barang"
                        style="@style/SF.Text"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_muted"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="@color/sf_muted"
                        android:textSize="9sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tab_batch"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_layers"
                        app:tint="@color/sf_brand" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Batch"
                        android:textColor="@color/sf_brand"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tv_count_tab_batch"
                        style="@style/SF.Text"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_pill_brand"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="1dp"
                        android:text="0"
                        android:textColor="@color/sf_brand"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/sf_muted_2" />

                <EditText
                    android:id="@+id/et_search_batch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:hint="Cari batch, barang, atau status…"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/sf_ink"
                    android:textColorHint="@color/sf_muted_2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_jumlah_batch_label"
                    style="@style/SF.Text.Caption"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:text="0 batch" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="1dp"
                    android:paddingBottom="3dp">

                    <TextView
                        android:id="@+id/chip_batch_semua"
                        style="@style/SF.Chip.Active"
                        android:text="Semua" />

                    <LinearLayout
                        android:id="@+id/chip_batch_aman"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_safe" />

                        <TextView
                            style="@style/SF.Text"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:singleLine="true"
                            android:text="Aman"
                            android:textColor="@color/sf_chip_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chip_batch_mendekati"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_warn" />

                        <TextView
                            style="@style/SF.Text"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:singleLine="true"
                            android:text="Mendekati"
                            android:textColor="@color/sf_chip_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chip_batch_kedaluwarsa"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_danger" />

                        <TextView
                            style="@style/SF.Text"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:singleLine="true"
                            android:text="Kedaluwarsa"
                            android:textColor="@color/sf_chip_text"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chip_batch_ditangani"
                        android:layout_width="wrap_content"
                        android:layout_height="30dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/dot_muted" />

                        <TextView
                            style="@style/SF.Text"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/plus_jakarta_sans_bold"
                            android:singleLine="true"
                            android:text="Ditangani"
                            android:textColor="@color/sf_chip_text"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_alert_info"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic12_clock"
                    app:tint="@color/sf_info" />

                <TextView
                    style="@style/SF.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/sf_batch_fefo_info"
                    android:textColor="@color/sf_info_ink"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_batch_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="3"
                tools:listitem="@layout/item_batch_card" />

            <LinearLayout
                android:id="@+id/empty_state_batch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_empty"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ic_muted">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_search"
                        app:tint="@color/sf_muted" />
                </FrameLayout>

                <TextView
                    style="@style/SF.Text.Strong"
                    android:layout_marginTop="9dp"
                    android:text="Hasil tidak ditemukan" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Coba kata kunci atau status lain." />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginStart="6dp"
                    android:text="Sumber: batch_stok · status dihitung dari tanggal kedaluwarsa" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/view_tabbar_owner_barang"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>