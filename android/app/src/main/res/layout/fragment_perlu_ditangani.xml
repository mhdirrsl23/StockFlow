<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back_perlu_ditangani"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Perlu ditangani"
            android:textSize="18sp" />

        <FrameLayout
            android:id="@+id/btn_notifikasi_ditangani"
            android:layout_width="36dp"
            android:layout_height="36dp">

            <ImageView
                style="@style/SF.IconBtn"
                android:src="@drawable/ic_bell" />

            <TextView
                android:id="@+id/tv_badge_notif_ditangani"
                style="@style/SF.Text"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="center"
                android:text="4"
                android:textColor="@color/sf_on_brand"
                android:textSize="8sp" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_ic_danger">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_package_x"
                        app:tint="@color/sf_danger" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:letterSpacing="-0.035"
                        android:text="Perlu Ditangani"
                        android:textColor="@color/sf_ink"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:text="View " />

                        <TextView
                            style="@style/SF.Text.Mono"
                            android:fontFamily="monospace"
                            android:text="v_perlu_ditangani"
                            android:textColor="@color/sf_muted"
                            android:textSize="10sp" />

                        <TextView
                            style="@style/SF.Text.Caption"
                            android:text=" · batch Kedaluwarsa" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Peringatan -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert_danger"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_alert_triangle"
                    app:tint="@color/sf_danger_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="Batch menunggu penanganan."
                        android:textColor="@color/sf_danger_ink"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.3"
                        android:text="Stok kedaluwarsa tidak boleh dijual. Pilih tindakan: dimusnahkan, dikembalikan ke pemasok, atau lainnya."
                        android:textColor="@color/sf_danger_ink"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- RecyclerView untuk Daftar Batch Perlu Ditangani -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_perlu_ditangani"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_batch_card" />

            <!-- State kosong jika tidak ada yang perlu ditangani -->
            <LinearLayout
                android:id="@+id/empty_state_perlu_ditangani"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_empty"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ic_safe">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic12_check_circle"
                        app:tint="@color/sf_safe" />
                </FrameLayout>

                <TextView
                    style="@style/SF.Text.Strong"
                    android:layout_marginTop="9dp"
                    android:text="Aman, tidak ada batch kedaluwarsa" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Semua stok batch dalam kondisi aman atau sudah ditangani." />
            </LinearLayout>

            <!-- Catatan sumber -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="2dp">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_database"
                    app:tint="@color/sf_muted_2" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginStart="6dp"
                    android:text="Sumber: view v_perlu_ditangani · sisa_hari = DATEDIFF(tanggal_kedaluwarsa, hari ini)" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>