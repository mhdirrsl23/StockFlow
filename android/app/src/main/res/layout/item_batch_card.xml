<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_card_14"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/bg_icon_card_batch"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/bg_product_drink">

            <ImageView
                android:id="@+id/iv_icon_card_batch"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cup"
                app:tint="#2C6B93" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_nama_barang"
                style="@style/SF.Text.RowTitle"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:text="Nama Barang" />

            <TextView
                android:id="@+id/tv_card_nomor_batch"
                style="@style/SF.Text.BatchCode"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:text="BATCH-001" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_card_pill_status"
            style="@style/SF.Pill.Safe"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic12_check_circle"
            android:text="Aman" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:background="@color/sf_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/SF.Text"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:letterSpacing="0.06"
                android:text="SISA / AWAL"
                android:textColor="@color/sf_muted_2"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_card_sisa_awal"
                    style="@style/SF.Text"
                    android:fontFamily="@font/plus_jakarta_sans_bold"
                    android:singleLine="true"
                    android:text="30 / 30"
                    android:textColor="@color/sf_ink"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_card_satuan"
                    style="@style/SF.Text"
                    android:layout_marginStart="3dp"
                    android:paddingBottom="1dp"
                    android:text="pcs"
                    android:textColor="@color/sf_muted"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                style="@style/SF.Text"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:letterSpacing="0.06"
                android:text="KEDALUWARSA"
                android:textColor="@color/sf_muted_2"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_card_kedaluwarsa"
                style="@style/SF.Text"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/plus_jakarta_sans_bold"
                android:singleLine="true"
                android:text="29 Okt 2026"
                android:textColor="@color/sf_ink"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                style="@style/SF.Text"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:gravity="end"
                android:letterSpacing="0.06"
                android:text="STATUS"
                android:textColor="@color/sf_muted_2"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/tv_card_status_desc"
                style="@style/SF.Text"
                android:layout_marginTop="2dp"
                android:gravity="end"
                android:singleLine="true"
                android:text="Kedaluwarsa dalam 30 hr lagi"
                android:textColor="@color/sf_muted"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_card_batch"
        style="@style/SF.Progress"
        android:layout_marginTop="7dp"
        android:progress="100" />
</LinearLayout>