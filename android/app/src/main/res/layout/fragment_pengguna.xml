<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:orientation="vertical"
    tools:ignore="HardcodedText,ContentDescription,UseCompatTextViewDrawableXml">

    <!-- Topbar sub-halaman -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_topbar_sub"
        android:gravity="center_vertical"
        android:minHeight="62dp"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="17dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/btn_back_pengguna"
            style="@style/SF.IconBtn.Boxed"
            android:src="@drawable/ic_arrow_left" />

        <TextView
            style="@style/SF.Text.Title"
            android:layout_width="0dp"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="Akun pengguna"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/btn_tambah_pengguna"
            style="@style/SF.IconBtn.Boxed"
            android:layout_marginStart="11dp"
            android:src="@drawable/ic_plus" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="26dp">

            <!-- Metrik -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_total_akun"
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="0" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="total akun" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_aktif_akun"
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="0"
                        android:textColor="@color/sf_safe" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="aktif" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_12"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_stat_staf_akun"
                        style="@style/SF.Text.Title"
                        android:letterSpacing="-0.04"
                        android:text="0" />

                    <TextView
                        style="@style/SF.Text.Caption"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/plus_jakarta_sans_bold"
                        android:text="staf" />
                </LinearLayout>
            </LinearLayout>

            <!-- Alert strip info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_alert_info"
                android:orientation="horizontal"
                android:paddingHorizontal="11dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/sf_info_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SF.Text"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:text="Akun staf dibuat pemilik."
                        android:textColor="@color/sf_info_ink"
                        android:textSize="11sp" />

                    <TextView
                        style="@style/SF.Text"
                        android:layout_marginTop="1dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="Tidak ada registrasi mandiri. Menonaktifkan akun mencabut seluruh token Sanctum miliknya."
                        android:textColor="@color/sf_info_ink"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- RecyclerView untuk Daftar Pengguna -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_pengguna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_barang" />

            <!-- State kosong jika tidak ada pengguna -->
            <LinearLayout
                android:id="@+id/empty_state_pengguna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_empty"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_ic_muted">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/sf_muted" />
                </FrameLayout>

                <TextView
                    style="@style/SF.Text.Strong"
                    android:layout_marginTop="9dp"
                    android:text="Tidak ada data pengguna" />

                <TextView
                    style="@style/SF.Text.Caption"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="Belum ada akun yang terdaftar pada sistem." />
            </LinearLayout>


        </LinearLayout>
    </ScrollView>
</LinearLayout>