                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar tab utama -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"66dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <LinearLayout\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_weight=\"1\"\n            android:orientation=\"vertical\">\n\n            <TextView\n                style=\"@style/SF.Text.Title\"\n                android:singleLine=\"true\"\n                android:text=\"Laporan\"\n                android:textSize=\"18sp\" />\n\n            <TextView\n                style=\"@style/SF.Text.Caption\"\n                android:layout_marginTop=\"3dp\"\n                android:singleLine=\"true\"\n                android:text=\"Stok, mutasi &amp; audit\" />\n        </LinearLayout>\n\n        <!-- Notifikasi + badge -->\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"36dp\">\n\n            <ImageView\n                style=\"@style/SF.IconBtn\"\n                android:src=\"@drawable/ic_bell\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"16dp\"\n                android:layout_height=\"16dp\"\n                android:layout_gravity=\"top|end\"\n                android:background=\"@drawable/bg_badge\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:gravity=\"center\"\n                android:text=\"4\"\n                android:textColor=\"@color/sf_on_brand\"\n                android:textSize=\"8sp\" />\n        </FrameLayout>\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Tab laporan -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:background=\"@drawable/bg_segmented\"\n                android:orientation=\"horizontal\"\n                android:padding=\"3dp\">\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"32dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_segment_active\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:gravity=\"center\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"Stok\"\n                    android:textColor=\"@color/sf_brand\"\n                    android:textSize=\"11sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"32dp\"\n                    android:layout_marginStart=\"2dp\"\n                    android:layout_weight=\"1\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:gravity=\"center\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"Mutasi\"\n                    android:textColor=\"#6E8277\"\n                    android:textSize=\"11sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"32dp\"\n                    android:layout_marginStart=\"2dp\"\n                    android:layout_weight=\"1\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:gravity=\"center\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"Kedaluwarsa\"\n                    android:textColor=\"#6E8277\"\n                    android:textSize=\"11sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"32dp\"\n                    android:layout_marginStart=\"2dp\"\n                    android:layout_weight=\"1\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:gravity=\"center\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"Aktivitas\"\n                    android:textColor=\"#6E8277\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Ringkasan 3 metrik -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"5\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"barang aktif\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"215\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"unit tersedia\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"2\"\n                        android:textColor=\"@color/sf_warn\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"stok menipis\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Header + CSV -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"31dp\"\n                android:gravity=\"bottom\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Section\"\n                        android:text=\"Stok tersedia\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"View v_stok_tersedia · batch kedaluwarsa &amp; ditangani tidak dihitung\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Btn.Ghost\"\n                    android:layout_height=\"36dp\"\n                    android:layout_marginStart=\"10dp\"\n                    android:drawableStart=\"@drawable/ic12_download\"\n                    android:paddingHorizontal=\"12dp\"\n                    android:text=\"CSV\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Daftar stok -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"15dp\"\n                android:paddingVertical=\"3dp\">\n\n                <!-- Indomie Goreng -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_food\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cookie\"\n                            app:tint=\"#9A6515\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Indomie Goreng\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-MKN-001 · Makanan\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"150\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"pcs\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 50\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Safe\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_check_circle\"\n                        android:text=\"Aman\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Ultra Milk -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_drink\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cup\"\n                            app:tint=\"#2C6B93\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Ultra Milk Full Cream 250ml\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-MNM-001 · Minuman\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"40\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"pcs\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 20\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Safe\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_check_circle\"\n                        android:text=\"Aman\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Paracetamol -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_med\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_pill\"\n                            app:tint=\"#9D4D59\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Paracetamol 500mg\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-UBT-001 · Obat\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"20\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"box\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 10\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Safe\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_check_circle\"\n                        android:text=\"Aman\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Sunlight -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_home\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_droplet\"\n                            app:tint=\"#397A55\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Sunlight 755ml\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-RMH-001 · Kebutuhan Rumah\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"5\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"pcs\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 15\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Menipis\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Tisu Basah -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_other\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_package\"\n                            app:tint=\"#66756C\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Tisu Basah\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-LNY-001 · Lainnya\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"0\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"pack\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 10\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Menipis\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- csv-note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"11dp\"\n                    android:layout_height=\"11dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_info\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Total unit menjumlahkan satuan berbeda (pcs, box, pack); bukan nilai uang — skema tidak punya kolom harga.\"\n                    android:textColor=\"@color/sf_muted_2\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"11dp\"\n                    android:layout_height=\"11dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: v_stok_tersedia · status_stok ≤ stok_minimum = Stok Menipis\"\n                    android:textColor=\"@color/sf_muted_2\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <include\n        layout=\"@layout/view_tabbar_owner_laporan\"\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\" />\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 4,
                                    "endLine": 695,
                                    "snippet": {
                                        "text": "  Data contoh = seed stockflow_database.sql (30 Okt 2026). Tab aktif: Laporan, sub-tab Stok.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar tab utama -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"66dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <LinearLayout\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_weight=\"1\"\n            android:orientation=\"vertical\">\n\n            <TextView\n                style=\"@style/SF.Text.Title\"\n                android:singleLine=\"true\"\n                android:text=\"Laporan\"\n                android:textSize=\"18sp\" />\n\n            <TextView\n                style=\"@style/SF.Text.Caption\"\n                android:layout_marginTop=\"3dp\"\n                android:singleLine=\"true\"\n                android:text=\"Stok, mutasi &amp; audit\" />\n        </LinearLayout>\n\n        <!-- Notifikasi + badge -->\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"36dp\">\n\n            <ImageView\n                style=\"@style/SF.IconBtn\"\n                android:src=\"@drawable/ic_bell\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"16dp\"\n                android:layout_height=\"16dp\"\n                android:layout_gravity=\"top|end\"\n                android:background=\"@drawable/bg_badge\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:gravity=\"center\"\n                android:text=\"4\"\n                android:textColor=\"@color/sf_on_brand\"\n                android:textSize=\"8sp\" />\n        </FrameLayout>\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Tab laporan -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:background=\"@drawable/bg_segmented\"\n                android:orientation=\"horizontal\"\n                android:padding=\"3dp\">\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"32dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_segment_active\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:gravity=\"center\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"Stok\"\n                    android:textColor=\"@color/sf_brand\"\n                    android:textSize=\"11sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"32dp\"\n                    android:layout_marginStart=\"2dp\"\n                    android:layout_weight=\"1\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:gravity=\"center\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"Mutasi\"\n                    android:textColor=\"#6E8277\"\n                    android:textSize=\"11sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"32dp\"\n                    android:layout_marginStart=\"2dp\"\n                    android:layout_weight=\"1\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:gravity=\"center\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"Kedaluwarsa\"\n                    android:textColor=\"#6E8277\"\n                    android:textSize=\"11sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"32dp\"\n                    android:layout_marginStart=\"2dp\"\n                    android:layout_weight=\"1\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:gravity=\"center\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"Aktivitas\"\n                    android:textColor=\"#6E8277\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Ringkasan 3 metrik -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"5\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"barang aktif\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"215\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"unit tersedia\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"2\"\n                        android:textColor=\"@color/sf_warn\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"stok menipis\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Header + CSV -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"31dp\"\n                android:gravity=\"bottom\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Section\"\n                        android:text=\"Stok tersedia\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"View v_stok_tersedia · batch kedaluwarsa &amp; ditangani tidak dihitung\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Btn.Ghost\"\n                    android:layout_height=\"36dp\"\n                    android:layout_marginStart=\"10dp\"\n                    android:drawableStart=\"@drawable/ic12_download\"\n                    android:paddingHorizontal=\"12dp\"\n                    android:text=\"CSV\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Daftar stok -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"15dp\"\n                android:paddingVertical=\"3dp\">\n\n                <!-- Indomie Goreng -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_food\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cookie\"\n                            app:tint=\"#9A6515\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Indomie Goreng\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-MKN-001 · Makanan\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"150\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"pcs\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 50\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Safe\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_check_circle\"\n                        android:text=\"Aman\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Ultra Milk -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_drink\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cup\"\n                            app:tint=\"#2C6B93\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Ultra Milk Full Cream 250ml\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-MNM-001 · Minuman\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"40\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"pcs\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 20\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Safe\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_check_circle\"\n                        android:text=\"Aman\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Paracetamol -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_med\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_pill\"\n                            app:tint=\"#9D4D59\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Paracetamol 500mg\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-UBT-001 · Obat\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"20\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"box\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 10\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Safe\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_check_circle\"\n                        android:text=\"Aman\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Sunlight -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_home\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_droplet\"\n                            app:tint=\"#397A55\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Sunlight 755ml\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-RMH-001 · Kebutuhan Rumah\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"5\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"pcs\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 15\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Menipis\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Tisu Basah -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingVertical=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_other\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_package\"\n                            app:tint=\"#66756C\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Tisu Basah\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"SKU-LNY-001 · Lainnya\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"0\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"pack\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"min. 10\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"9dp\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Menipis\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- csv-note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"11dp\"\n                    android:layout_height=\"11dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_info\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Total unit menjumlahkan satuan berbeda (pcs, box, pack); bukan nilai uang — skema tidak punya kolom harga.\"\n                    android:textColor=\"@color/sf_muted_2\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"11dp\"\n                    android:layout_height=\"11dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: v_stok_tersedia · status_stok ≤ stok_minimum = Stok Menipis\"\n                    android:textColor=\"@color/sf_muted_2\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <include\n        layout=\"@layout/view_tabbar_owner_laporan\"\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\" />\n</LinearLayout>\n"
