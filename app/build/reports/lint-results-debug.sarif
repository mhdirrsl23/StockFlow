                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:ellipsize=\"end\"\n            android:singleLine=\"true\"\n            android:text=\"Perlu ditangani\"\n            android:textSize=\"18sp\" />\n\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"36dp\">\n\n            <ImageView\n                style=\"@style/SF.IconBtn\"\n                android:src=\"@drawable/ic_bell\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"16dp\"\n                android:layout_height=\"16dp\"\n                android:layout_gravity=\"top|end\"\n                android:background=\"@drawable/bg_badge\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:gravity=\"center\"\n                android:text=\"4\"\n                android:textColor=\"@color/sf_on_brand\"\n                android:textSize=\"8sp\" />\n        </FrameLayout>\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Hero -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\">\n\n                <FrameLayout\n                    android:layout_width=\"44dp\"\n                    android:layout_height=\"44dp\"\n                    android:background=\"@drawable/bg_ic_danger\">\n\n                    <ImageView\n                        android:layout_width=\"20dp\"\n                        android:layout_height=\"20dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_package_x\"\n                        app:tint=\"@color/sf_danger\" />\n                </FrameLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"12dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                        android:letterSpacing=\"-0.035\"\n                        android:text=\"Perlu Ditangani\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"17sp\" />\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"3dp\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:text=\"View \" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Mono\"\n                            android:fontFamily=\"monospace\"\n                            android:text=\"v_perlu_ditangani\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"10sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:text=\" · batch Kedaluwarsa\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Peringatan -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_alert_danger\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_alert_triangle\"\n                    app:tint=\"@color/sf_danger_ink\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"1 batch menunggu penanganan.\"\n                        android:textColor=\"@color/sf_danger_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"2dp\"\n                        android:lineSpacingMultiplier=\"1.3\"\n                        android:text=\"Stok kedaluwarsa tidak boleh dijual. Pilih tindakan: dimusnahkan, dikembalikan ke pemasok, atau lainnya.\"\n                        android:textColor=\"@color/sf_danger_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Kartu batch -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_14\"\n                android:orientation=\"vertical\"\n                android:padding=\"12dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_drink\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cup\"\n                            app:tint=\"#2C6B93\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:ellipsize=\"end\"\n                            android:singleLine=\"true\"\n                            android:text=\"Ultra Milk Full Cream 250ml\" />\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"3dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.BatchCode\"\n                                android:text=\"MLK-2411B\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_marginStart=\"4dp\"\n                                android:text=\"· SKU-MNM-001\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Danger\"\n                        android:layout_marginStart=\"8dp\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Kedaluwarsa\" />\n                </LinearLayout>\n\n                <View\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"1dp\"\n                    android:layout_marginTop=\"10dp\"\n                    android:background=\"@color/sf_line\" />\n\n                <!-- Metrik batch -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"8dp\"\n                    android:orientation=\"horizontal\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:letterSpacing=\"0.06\"\n                            android:text=\"SISA\"\n                            android:textColor=\"@color/sf_muted_2\"\n                            android:textSize=\"9sp\" />\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"2dp\"\n                            android:gravity=\"bottom\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"30\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"11sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginStart=\"2dp\"\n                                android:paddingBottom=\"1dp\"\n                                android:text=\"pcs\"\n                                android:textColor=\"@color/sf_muted\"\n                                android:textSize=\"9sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:letterSpacing=\"0.06\"\n                            android:text=\"KEDALUWARSA\"\n                            android:textColor=\"@color/sf_muted_2\"\n                            android:textSize=\"9sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"2dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                            android:text=\"29 Okt 2026\"\n                            android:textColor=\"@color/sf_ink\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:letterSpacing=\"0.06\"\n                            android:text=\"LEWAT\"\n                            android:textColor=\"@color/sf_muted_2\"\n                            android:textSize=\"9sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"2dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                            android:text=\"1 hari\"\n                            android:textColor=\"@color/sf_danger\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <!-- Aksi batch -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"10dp\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Btn.Ghost\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"36dp\"\n                        android:layout_weight=\"1\"\n                        android:drawableStart=\"@drawable/ic12_box\"\n                        android:gravity=\"center\"\n                        android:paddingHorizontal=\"12dp\"\n                        android:text=\"Barang\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Btn.Danger\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"36dp\"\n                        android:layout_marginStart=\"6dp\"\n                        android:layout_weight=\"1\"\n                        android:drawableStart=\"@drawable/ic12_package_x\"\n                        android:gravity=\"center\"\n                        android:paddingHorizontal=\"12dp\"\n                        android:text=\"Tangani batch\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Catatan sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"13dp\"\n                    android:layout_height=\"13dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"6dp\"\n                    android:text=\"Sumber: view v_perlu_ditangani · sisa_hari = DATEDIFF(tanggal_kedaluwarsa, hari ini)\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
