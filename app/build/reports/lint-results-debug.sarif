                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uriBaseId": "%SRCROOT%",
                                    "uri": "app/src/main/res/layout/form_akun.xml"
                                },
                                "region": {
                                    "startLine": 6,
                                    "startColumn": 1,
                                    "endLine": 495,
                                    "endColumn": 16,
                                    "charOffset": 177,
                                    "charLength": 20257,
                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            android:id=\"@+id/btn_back\"\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"12dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Tambah akun\"\n            android:textSize=\"18sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Form intro -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Title\"\n                    android:text=\"Tambah akun\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Muted\"\n                    android:layout_marginTop=\"4dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Buat akun staf atau pemilik. Tidak ada registrasi mandiri; akun dikelola pemilik.\"\n                    android:textSize=\"12sp\" />\n            </LinearLayout>\n\n            <!-- Section: Identitas akun -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_user\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Identitas akun\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <!-- Nama lengkap -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Nama lengkap\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <EditText\n                    android:id=\"@+id/et_nama\"\n                    style=\"@style/SF.Input\"\n                    android:layout_marginTop=\"5dp\"\n                    android:inputType=\"textPersonName|textCapWords\"\n                    android:maxLength=\"100\" />\n\n                <!-- Username -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Username\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_semibold\"\n                        android:gravity=\"end\"\n                        android:text=\"Unik\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_key\"\n                        app:tint=\"#8EA096\" />\n\n                    <EditText\n                        android:id=\"@+id/et_username\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:background=\"@null\"\n                        android:includeFontPadding=\"false\"\n                        android:inputType=\"textNoSuggestions\"\n                        android:maxLength=\"50\"\n                        android:paddingStart=\"8dp\"\n                        android:paddingTop=\"11dp\"\n                        android:paddingEnd=\"11dp\"\n                        android:paddingBottom=\"11dp\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textColorHint=\"#A1B0A8\"\n                        android:textSize=\"13sp\" />\n                </LinearLayout>\n\n                <!-- Kata sandi -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Kata sandi\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <EditText\n                    android:id=\"@+id/et_password\"\n                    style=\"@style/SF.Input\"\n                    android:layout_marginTop=\"5dp\"\n                    android:hint=\"Minimal 6 karakter\"\n                    android:inputType=\"textPassword\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Simulasi mockup; Laravel menyimpan hash bcrypt.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Section: Peran & status -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_shield_check\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Peran &amp; status\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Peran\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:id=\"@+id/select_peran\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"11dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Staf\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"13sp\" />\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:rotation=\"90\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"#799085\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Pemilik dapat mengelola akun, pengaturan, dan laporan. Staf fokus operasional stok &amp; riwayat sendiri.\" />\n                </LinearLayout>\n\n                <!-- Switch: Akun aktif -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"2dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Akun aktif\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"Nonaktif = login ditolak &amp; token dicabut.\" />\n                    </LinearLayout>\n\n                    <com.google.android.material.materialswitch.MaterialSwitch\n                        android:id=\"@+id/switch_aktif\"\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"12dp\"\n                        android:checked=\"true\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Form note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:padding=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_clipboard_check\"\n                    app:tint=\"#35647E\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"6dp\"\n                    android:layout_weight=\"1\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Menyimpan akun mencatat riwayat aktivitas tambah users. Username harus unik.\"\n                    android:textColor=\"#35647E\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"wrap_content\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"10dp\"\n                    android:layout_height=\"10dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: tabel users · password bcrypt · peran pemilik/staf\"\n                    android:textColor=\"@color/sf_muted_2\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Actionbar -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            android:id=\"@+id/btn_batal\"\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batal\" />\n\n        <TextView\n            android:id=\"@+id/btn_simpan\"\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"8dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_save\"\n            android:text=\"Buat akun\" />\n    </LinearLayout>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 4,
                                    "endLine": 496,
                                    "snippet": {
                                        "text": "  Kolom tabel users: nama, username, password (bcrypt), peran, aktif.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            android:id=\"@+id/btn_back\"\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"12dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Tambah akun\"\n            android:textSize=\"18sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Form intro -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Title\"\n                    android:text=\"Tambah akun\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Muted\"\n                    android:layout_marginTop=\"4dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Buat akun staf atau pemilik. Tidak ada registrasi mandiri; akun dikelola pemilik.\"\n                    android:textSize=\"12sp\" />\n            </LinearLayout>\n\n            <!-- Section: Identitas akun -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_user\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Identitas akun\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <!-- Nama lengkap -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Nama lengkap\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <EditText\n                    android:id=\"@+id/et_nama\"\n                    style=\"@style/SF.Input\"\n                    android:layout_marginTop=\"5dp\"\n                    android:inputType=\"textPersonName|textCapWords\"\n                    android:maxLength=\"100\" />\n\n                <!-- Username -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Username\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_semibold\"\n                        android:gravity=\"end\"\n                        android:text=\"Unik\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_key\"\n                        app:tint=\"#8EA096\" />\n\n                    <EditText\n                        android:id=\"@+id/et_username\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:background=\"@null\"\n                        android:includeFontPadding=\"false\"\n                        android:inputType=\"textNoSuggestions\"\n                        android:maxLength=\"50\"\n                        android:paddingStart=\"8dp\"\n                        android:paddingTop=\"11dp\"\n                        android:paddingEnd=\"11dp\"\n                        android:paddingBottom=\"11dp\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textColorHint=\"#A1B0A8\"\n                        android:textSize=\"13sp\" />\n                </LinearLayout>\n\n                <!-- Kata sandi -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Kata sandi\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <EditText\n                    android:id=\"@+id/et_password\"\n                    style=\"@style/SF.Input\"\n                    android:layout_marginTop=\"5dp\"\n                    android:hint=\"Minimal 6 karakter\"\n                    android:inputType=\"textPassword\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Simulasi mockup; Laravel menyimpan hash bcrypt.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Section: Peran & status -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_shield_check\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Peran &amp; status\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Peran\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:id=\"@+id/select_peran\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"11dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Staf\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"13sp\" />\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:rotation=\"90\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"#799085\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Pemilik dapat mengelola akun, pengaturan, dan laporan. Staf fokus operasional stok &amp; riwayat sendiri.\" />\n                </LinearLayout>\n\n                <!-- Switch: Akun aktif -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"2dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Akun aktif\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"Nonaktif = login ditolak &amp; token dicabut.\" />\n                    </LinearLayout>\n\n                    <com.google.android.material.materialswitch.MaterialSwitch\n                        android:id=\"@+id/switch_aktif\"\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"12dp\"\n                        android:checked=\"true\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Form note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:padding=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_clipboard_check\"\n                    app:tint=\"#35647E\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"6dp\"\n                    android:layout_weight=\"1\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Menyimpan akun mencatat riwayat aktivitas tambah users. Username harus unik.\"\n                    android:textColor=\"#35647E\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"wrap_content\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"10dp\"\n                    android:layout_height=\"10dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: tabel users · password bcrypt · peran pemilik/staf\"\n                    android:textColor=\"@color/sf_muted_2\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Actionbar -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            android:id=\"@+id/btn_batal\"\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batal\" />\n\n        <TextView\n            android:id=\"@+id/btn_simpan\"\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"8dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_save\"\n            android:text=\"Buat akun\" />\n    </LinearLayout>\n</LinearLayout>\n"
                                    }
                                }
                            }
