oid:text=\"Tautan yang Anda buka tidak tersedia pada edisi database ini.\" />\n\n                <TextView\n                    style=\"@style/SF.Btn.Primary\"\n                    android:layout_height=\"36dp\"\n                    android:layout_marginTop=\"8dp\"\n                    android:paddingHorizontal=\"12dp\"\n                    android:text=\"Buka beranda\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n        </LinearLayout>\n    </ScrollView>\n</LinearLayout>"
