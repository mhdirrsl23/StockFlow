ll\"\n                            app:tint=\"#9D4D59\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:gravity=\"center_horizontal\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:ellipsize=\"end\"\n                            android:gravity=\"center\"\n                            android:singleLine=\"true\"\n                            android:text=\"Paracetamol 500mg\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_gravity=\"center_horizontal\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"PRC-2410B\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Muted\"\n                        android:layout_marginStart=\"8dp\"\n                        android:drawableStart=\"@drawable/ic12_archive\"\n                        android:text=\"Ditangani\" />\n                </LinearLayout>\n\n                <View\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"1dp\"\n                    android:layout_marginTop=\"9dp\"\n                    android:background=\"@color/sf_line\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"9dp\"\n                    android:gravity=\"center_vertical\"\n                    an