                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            android:id=\"@+id/btn_back\"\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"12dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Stok keluar\"\n            android:textSize=\"18sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Form intro -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Title\"\n                    android:text=\"Catat stok keluar\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Muted\"\n                    android:layout_marginTop=\"4dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Alokasi otomatis memakai FEFO: batch dengan tanggal kedaluwarsa terdekat dipotong lebih dulu. Setiap batch yang terpakai menghasilkan satu baris mutasi keluar.\"\n                    android:textSize=\"12sp\" />\n            </LinearLayout>\n\n            <!-- Section: Pengeluaran -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_arrow_up_right\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Pengeluaran\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <!-- Barang -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Barang\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:id=\"@+id/select_barang\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"11dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:ellipsize=\"end\"\n                        android:singleLine=\"true\"\n                        android:text=\"Indomie Goreng · tersedia 150 pcs\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"13sp\" />\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"8dp\"\n                        android:rotation=\"90\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"#799085\" />\n                </LinearLayout>\n\n                <!-- Jumlah keluar -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Jumlah keluar\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"42dp\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:id=\"@+id/btn_keluar_minus\"\n                        android:layout_width=\"37dp\"\n                        android:layout_height=\"match_parent\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:paddingHorizontal=\"11.5dp\"\n                        android:paddingVertical=\"14dp\"\n                        android:src=\"@drawable/ic_minus\"\n                        app:tint=\"#486458\" />\n\n                    <EditText\n                        android:id=\"@+id/keluar_jumlah\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"match_parent\"\n                        android:layout_weight=\"1\"\n                        android:background=\"@null\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"center\"\n                        android:includeFontPadding=\"false\"\n                        android:inputType=\"number\"\n                        android:padding=\"0dp\"\n                        android:text=\"120\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"14sp\" />\n\n                    <ImageView\n                        android:id=\"@+id/btn_keluar_plus\"\n                        android:layout_width=\"37dp\"\n                        android:layout_height=\"match_parent\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:paddingHorizontal=\"11.5dp\"\n                        android:paddingVertical=\"14dp\"\n                        android:src=\"@drawable/ic_plus\"\n                        app:tint=\"#486458\" />\n                </LinearLayout>\n\n                <!-- Catatan -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Catatan\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_semibold\"\n                        android:gravity=\"end\"\n                        android:text=\"Opsional\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <EditText\n                    android:id=\"@+id/et_catatan\"\n                    style=\"@style/SF.Input\"\n                    android:layout_marginTop=\"5dp\"\n                    android:hint=\"Contoh: Penjualan harian\"\n                    android:maxLength=\"255\"\n                    android:text=\"Penjualan harian\" />\n            </LinearLayout>\n\n            <!-- Section: Pratinjau alokasi FEFO -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_layers\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Pratinjau alokasi FEFO\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Otomatis\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <!-- Tersedia + pill -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"2dp\"\n                    android:paddingTop=\"1dp\"\n                    android:paddingEnd=\"2dp\"\n                    android:paddingBottom=\"8dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:text=\"Tersedia \" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"150 pcs\"\n                        android:textColor=\"@color/sf_ink\" />\n\n                    <TextView\n                        style=\"@style/SF.Pill.Safe\"\n                        android:text=\"Cukup\" />\n                </LinearLayout>\n\n                <!-- Alloc list -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:background=\"@drawable/bg_form_alloc\"\n                    android:orientation=\"vertical\"\n                    android:paddingHorizontal=\"10dp\"\n                    android:paddingVertical=\"2dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingVertical=\"8dp\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Mono\"\n                            android:fontFamily=\"monospace\"\n                            android:text=\"MGN-2411B\"\n                            android:textSize=\"10sp\"\n                            android:textStyle=\"bold\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Muted\"\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_weight=\"1\"\n                            android:text=\" · exp 29 Nov 2026\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:text=\"50 pcs\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingVertical=\"8dp\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Mono\"\n                            android:fontFamily=\"monospace\"\n                            android:text=\"MGN-2411A\"\n                            android:textSize=\"10sp\"\n                            android:textStyle=\"bold\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Muted\"\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_weight=\"1\"\n                            android:text=\" · exp 30 Nov 2026\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:text=\"70 pcs\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <!-- Field hint -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"8dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_check_circle\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Total 120 pcs akan dipotong dari 2 batch, satu baris mutasi per batch.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Form note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:padding=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_info\"\n                    app:tint=\"#35647E\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"6dp\"\n                    android:layout_weight=\"1\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Stok tersedia dihitung dari batch yang belum kedaluwarsa dan belum ditangani (view v_stok_tersedia).\"\n                    android:textColor=\"#35647E\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"wrap_content\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"10dp\"\n                    android:layout_height=\"10dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: mutasi_stok.jenis = keluar · satu baris per batch terpakai\"\n                    android:textColor=\"@color/sf_muted_2\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Actionbar -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            android:id=\"@+id/btn_batal\"\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batal\" />\n\n        <TextView\n            android:id=\"@+id/btn_catat_keluar\"\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"8dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_arrow_up_right\"\n            android:text=\"Catat keluar\" />\n    </LinearLayout>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 4,
                                    "endLine": 524,
                                    "snippet": {
                                        "text": "  Contoh pratinjau: Indomie Goreng, jumlah 120 -> MGN-2411B 50 pcs lalu MGN-2411A 70 pcs.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            android:id=\"@+id/btn_back\"\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"12dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Stok keluar\"\n            android:textSize=\"18sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Form intro -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Title\"\n                    android:text=\"Catat stok keluar\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Muted\"\n                    android:layout_marginTop=\"4dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Alokasi otomatis memakai FEFO: batch dengan tanggal kedaluwarsa terdekat dipotong lebih dulu. Setiap batch yang terpakai menghasilkan satu baris mutasi keluar.\"\n                    android:textSize=\"12sp\" />\n            </LinearLayout>\n\n            <!-- Section: Pengeluaran -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_arrow_up_right\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Pengeluaran\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <!-- Barang -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Barang\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:id=\"@+id/select_barang\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"11dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:ellipsize=\"end\"\n                        android:singleLine=\"true\"\n                        android:text=\"Indomie Goreng · tersedia 150 pcs\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"13sp\" />\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"8dp\"\n                        android:rotation=\"90\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"#799085\" />\n                </LinearLayout>\n\n                <!-- Jumlah keluar -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Jumlah keluar\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"42dp\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:id=\"@+id/btn_keluar_minus\"\n                        android:layout_width=\"37dp\"\n                        android:layout_height=\"match_parent\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:paddingHorizontal=\"11.5dp\"\n                        android:paddingVertical=\"14dp\"\n                        android:src=\"@drawable/ic_minus\"\n                        app:tint=\"#486458\" />\n\n                    <EditText\n                        android:id=\"@+id/keluar_jumlah\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"match_parent\"\n                        android:layout_weight=\"1\"\n                        android:background=\"@null\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"center\"\n                        android:includeFontPadding=\"false\"\n                        android:inputType=\"number\"\n                        android:padding=\"0dp\"\n                        android:text=\"120\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"14sp\" />\n\n                    <ImageView\n                        android:id=\"@+id/btn_keluar_plus\"\n                        android:layout_width=\"37dp\"\n                        android:layout_height=\"match_parent\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:paddingHorizontal=\"11.5dp\"\n                        android:paddingVertical=\"14dp\"\n                        android:src=\"@drawable/ic_plus\"\n                        app:tint=\"#486458\" />\n                </LinearLayout>\n\n                <!-- Catatan -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Catatan\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_semibold\"\n                        android:gravity=\"end\"\n                        android:text=\"Opsional\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <EditText\n                    android:id=\"@+id/et_catatan\"\n                    style=\"@style/SF.Input\"\n                    android:layout_marginTop=\"5dp\"\n                    android:hint=\"Contoh: Penjualan harian\"\n                    android:maxLength=\"255\"\n                    android:text=\"Penjualan harian\" />\n            </LinearLayout>\n\n            <!-- Section: Pratinjau alokasi FEFO -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_layers\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Pratinjau alokasi FEFO\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Otomatis\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <!-- Tersedia + pill -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"2dp\"\n                    android:paddingTop=\"1dp\"\n                    android:paddingEnd=\"2dp\"\n                    android:paddingBottom=\"8dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:text=\"Tersedia \" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"150 pcs\"\n                        android:textColor=\"@color/sf_ink\" />\n\n                    <TextView\n                        style=\"@style/SF.Pill.Safe\"\n                        android:text=\"Cukup\" />\n                </LinearLayout>\n\n                <!-- Alloc list -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:background=\"@drawable/bg_form_alloc\"\n                    android:orientation=\"vertical\"\n                    android:paddingHorizontal=\"10dp\"\n                    android:paddingVertical=\"2dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingVertical=\"8dp\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Mono\"\n                            android:fontFamily=\"monospace\"\n                            android:text=\"MGN-2411B\"\n                            android:textSize=\"10sp\"\n                            android:textStyle=\"bold\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Muted\"\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_weight=\"1\"\n                            android:text=\" · exp 29 Nov 2026\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:text=\"50 pcs\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingVertical=\"8dp\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Mono\"\n                            android:fontFamily=\"monospace\"\n                            android:text=\"MGN-2411A\"\n                            android:textSize=\"10sp\"\n                            android:textStyle=\"bold\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Muted\"\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_weight=\"1\"\n                            android:text=\" · exp 30 Nov 2026\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:text=\"70 pcs\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <!-- Field hint -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"8dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_check_circle\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Total 120 pcs akan dipotong dari 2 batch, satu baris mutasi per batch.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Form note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:padding=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_info\"\n                    app:tint=\"#35647E\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"6dp\"\n                    android:layout_weight=\"1\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Stok tersedia dihitung dari batch yang belum kedaluwarsa dan belum ditangani (view v_stok_tersedia).\"\n                    android:textColor=\"#35647E\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"wrap_content\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"10dp\"\n                    android:layout_height=\"10dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: mutasi_stok.jenis = keluar · satu baris per batch terpakai\"\n                    android:textColor=\"@color/sf_muted_2\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Actionbar -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            android:id=\"@+id/btn_batal\"\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batal\" />\n\n        <TextView\n            android:id=\"@+id/btn_catat_keluar\"\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"8dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_arrow_up_right\"\n            android:text=\"Catat keluar\" />\n    </LinearLayout>\n</LinearLayout>\n"
                                    }
                                }
                            }
                        }
