oid:textSize=\"9sp\" />\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginStart=\"9dp\"\n                    android:src=\"@drawable/ic_chevron_right\"\n                    app:tint=\"#8EBAA5\" />\n            </LinearLayout>\n\n            <!-- Demo: staf -->\n            <LinearLayout\n                android:id=\"@+id/demo_staf\"\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"7dp\"\n                android:background=\"@drawable/bg_auth_demo\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"10dp\">\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"32dp\"\n                    android:layout_height=\"32dp\"\n                    android:background=\"@drawable/bg_auth_avatar\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                    android:gravity=\"center\"\n                    android:text=\"RW\"\n                    android:textColor=\"#C8F2DD\"\n                    android:textSize=\"10sp\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Rina Wulandari\"\n                        android:textColor=\"#EDFFF7\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"2dp\"\n                        android:text=\"@staf · kata sandi: password\"\n                        android:textColor=\"#8AB49F\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Pill\"\n                    android:background=\"@drawable/bg_auth_pill\"\n                    android:text=\"Staf\"\n                    android:textColor=\"#B5D9C7\"\n                    android:textSize=\"9sp\" />\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginStart=\"9dp\"\n                    android:src=\"@drawable/ic_chevron_right\"\n                    app:tint=\"#8EBAA5\" />\n            </LinearLayout>\n        </LinearLayout>\n\n        <!-- Dorong footer ke bawah -->\n        <View\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"0dp\"\n            android:layout_weight=\"1\" />\n\n        <!-- Footer -->\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginTop=\"22dp\"\n            android:background=\"@drawable/bg_auth_note\"\n            android:orientation=\"horizontal\"\n            android:padding=\"10dp\">\n\n            <ImageView\n                android:layout_width=\"13dp\"\n                android:layout_height=\"13dp\"\n                android:layout_marginTop=\"1dp\"\n                android:src=\"@drawable/ic_database\"\n                app:tint=\"#8DC8AB\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"0dp\"\n                android:layout_marginStart=\"6dp\"\n                android:layout_weight=\"1\"\n                android:lineSpacingMultiplier=\"1.25\"\n                android:text=\"Data uji: 5 barang · 7 batch · 4 notifikasi. Status dihitung relatif terhadap hari ini.\"\n                android:textColor=\"#90B7A3\"\n                android:textSize=\"11sp\" />\n        </LinearLayout>\n\n        <LinearLayout\n            android:layout_width=\"wrap_content\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginTop=\"8dp\"\n            android:gravity=\"center_vertical\"\n            android:orientation=\"horizontal\">\n\n            <ImageView\n                android:layout_width=\"12dp\"\n                android:layout_height=\"12dp\"\n                android:src=\"@drawable/ic_shield_check\"\n                app:tint=\"@color/sf_auth_foot_strong\" />\n\n            <TextView\n                style=\"@style/SF.Text.Mono\"\n                android:layout_marginStart=\"5dp\"\n                android:text=\"stockflow_database.sql · MySQL 8 · Laravel Sanctum\"\n                android:textColor=\"@color/sf_auth_foot_strong\"\n                android:textSize=\"10sp\" />\n        </LinearLayout>\n    </LinearLayout>\n</ScrollView>\n"
