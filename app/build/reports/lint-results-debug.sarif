                                    "charLength": 28433,
                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,TextFields,LabelFor\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:singleLine=\"true\"\n            android:text=\"Pengaturan\"\n            android:textSize=\"18sp\" />\n\n        <!-- Notifikasi + badge -->\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"36dp\"\n            android:layout_marginStart=\"11dp\">\n\n            <ImageView\n                style=\"@style/SF.IconBtn\"\n                android:src=\"@drawable/ic_bell\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"16dp\"\n                android:layout_height=\"16dp\"\n                android:layout_gravity=\"top|end\"\n                android:background=\"@drawable/bg_badge\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:gravity=\"center\"\n                android:text=\"4\"\n                android:textColor=\"@color/sf_on_brand\"\n                android:textSize=\"8sp\" />\n        </FrameLayout>\n\n        <TextView\n            style=\"@style/SF.Text\"\n            android:layout_width=\"33dp\"\n            android:layout_height=\"33dp\"\n            android:layout_marginStart=\"7dp\"\n            android:background=\"@drawable/bg_avatar\"\n            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n            android:gravity=\"center\"\n            android:text=\"BS\"\n            android:textColor=\"#17523A\"\n            android:textSize=\"11sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- settings-head -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\"\n                android:paddingVertical=\"1dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Title\"\n                    android:text=\"Pengaturan aplikasi\"\n                    android:textSize=\"16sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text.RowSub\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Key-value pada tabel pengaturan. Perubahan ambang langsung menghitung ulang status batch.\" />\n            </LinearLayout>\n\n            <!-- Seksi: Peringatan kedaluwarsa -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingBottom=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_clock\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Peringatan kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"FR-25\"\n                        android:textColor=\"@color/sf_muted_2\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Ambang peringatan -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Ambang peringatan\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"Batch dengan sisa hari ≤ nilai ini berstatus Mendekati Kedaluwarsa.\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <EditText\n                            style=\"@style/SF.Input\"\n                            android:layout_width=\"57dp\"\n                            android:layout_height=\"34dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:gravity=\"center\"\n                            android:inputType=\"number\"\n                            android:minHeight=\"0dp\"\n                            android:padding=\"5dp\"\n                            android:text=\"30\"\n                            android:textSize=\"12sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginStart=\"5dp\"\n                            android:text=\"hari\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Batas atas -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Batas atas tepat di ambang\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"Contoh: +30 hari dengan ambang 30 → Mendekati Kedaluwarsa (bukan Aman).\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"10dp\"\n                        android:text=\"Inklusif\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Zona waktu -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingTop=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Zona waktu\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"NOW() / CURDATE() memakai WIB di Laragon.\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Outline\"\n                        android:layout_marginStart=\"10dp\"\n                        android:text=\"Asia/Jakarta\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Seksi: Lampiran & impor -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingBottom=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_image\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Lampiran &amp; impor\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"BATAS\"\n                        android:textColor=\"@color/sf_muted_2\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Ukuran lampiran -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Ukuran maksimum lampiran\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"JPG/PNG untuk bukti batch dan penanganan.\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <EditText\n                            style=\"@style/SF.Input\"\n                            android:layout_width=\"57dp\"\n                            android:layout_height=\"34dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:gravity=\"center\"\n                            android:inputType=\"number\"\n                            android:minHeight=\"0dp\"\n                            android:padding=\"5dp\"\n                            android:text=\"2\"\n                            android:textSize=\"12sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginStart=\"5dp\"\n                            android:text=\"MB\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Maksimum baris impor -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingTop=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Maksimum baris impor\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"Batas impor CSV pada backend Laravel.\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <EditText\n                            style=\"@style/SF.Input\"\n                            android:layout_width=\"57dp\"\n                            android:layout_height=\"34dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:gravity=\"center\"\n                            android:inputType=\"number\"\n                            android:minHeight=\"0dp\"\n                            android:padding=\"5dp\"\n                            android:text=\"1000\"\n                            android:textSize=\"12sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginStart=\"5dp\"\n                            android:text=\"baris\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Seksi: Kategori tetap -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingBottom=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_tag\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Kategori tetap\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"ENUM\"\n                        android:textColor=\"@color/sf_muted_2\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:text=\"Makanan\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"Minuman\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"Obat\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"6dp\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:text=\"Kebutuhan Rumah\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"Lainnya\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"9dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginStart=\"4dp\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Kategori disimpan sebagai enum pada kolom barang.kategori; tidak ada tabel kategori terpisah.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Seksi: Penjadwal -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingBottom=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_calendar_clock\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Penjadwal\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"SISTEM\"\n                        android:textColor=\"@color/sf_muted_2\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Notifikasi\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"06.00 &amp; 18.00 WIB\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"WorkManager\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"Setiap 12 jam\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingTop=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Anti-duplikat\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"1 baris / jenis / batch / hari\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- form-note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"10dp\"\n                android:paddingVertical=\"9dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_shield_check\"\n                    app:tint=\"@color/sf_info_ink\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"6dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Hanya pemilik yang dapat mengubah pengaturan. Perubahan dicatat sebagai ubah_pengaturan pada riwayat aktivitas.\"\n                    android:textColor=\"@color/sf_info_ink\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"11dp\"\n                    android:layout_height=\"11dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: pengaturan · ambang_peringatan_hari, maks_ukuran_lampiran_mb, maks_baris_impor\"\n                    android:textColor=\"@color/sf_muted_2\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Aksi bawah -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batal\" />\n\n        <TextView\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"8dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_save\"\n            android:text=\"Simpan pengaturan\" />\n    </LinearLayout>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 4,
                                    "endLine": 697,
                                    "snippet": {
                                        "text": "  Nilai = seed pengaturan: ambang 30 hari, lampiran 2 MB, impor 1000 baris.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,TextFields,LabelFor\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:singleLine=\"true\"\n            android:text=\"Pengaturan\"\n            android:textSize=\"18sp\" />\n\n        <!-- Notifikasi + badge -->\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"36dp\"\n            android:layout_marginStart=\"11dp\">\n\n            <ImageView\n                style=\"@style/SF.IconBtn\"\n                android:src=\"@drawable/ic_bell\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"16dp\"\n                android:layout_height=\"16dp\"\n                android:layout_gravity=\"top|end\"\n                android:background=\"@drawable/bg_badge\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:gravity=\"center\"\n                android:text=\"4\"\n                android:textColor=\"@color/sf_on_brand\"\n                android:textSize=\"8sp\" />\n        </FrameLayout>\n\n        <TextView\n            style=\"@style/SF.Text\"\n            android:layout_width=\"33dp\"\n            android:layout_height=\"33dp\"\n            android:layout_marginStart=\"7dp\"\n            android:background=\"@drawable/bg_avatar\"\n            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n            android:gravity=\"center\"\n            android:text=\"BS\"\n            android:textColor=\"#17523A\"\n            android:textSize=\"11sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- settings-head -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\"\n                android:paddingVertical=\"1dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Title\"\n                    android:text=\"Pengaturan aplikasi\"\n                    android:textSize=\"16sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text.RowSub\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Key-value pada tabel pengaturan. Perubahan ambang langsung menghitung ulang status batch.\" />\n            </LinearLayout>\n\n            <!-- Seksi: Peringatan kedaluwarsa -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingBottom=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_clock\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Peringatan kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"FR-25\"\n                        android:textColor=\"@color/sf_muted_2\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Ambang peringatan -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Ambang peringatan\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"Batch dengan sisa hari ≤ nilai ini berstatus Mendekati Kedaluwarsa.\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <EditText\n                            style=\"@style/SF.Input\"\n                            android:layout_width=\"57dp\"\n                            android:layout_height=\"34dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:gravity=\"center\"\n                            android:inputType=\"number\"\n                            android:minHeight=\"0dp\"\n                            android:padding=\"5dp\"\n                            android:text=\"30\"\n                            android:textSize=\"12sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginStart=\"5dp\"\n                            android:text=\"hari\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Batas atas -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Batas atas tepat di ambang\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"Contoh: +30 hari dengan ambang 30 → Mendekati Kedaluwarsa (bukan Aman).\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"10dp\"\n                        android:text=\"Inklusif\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Zona waktu -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingTop=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Zona waktu\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"NOW() / CURDATE() memakai WIB di Laragon.\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Outline\"\n                        android:layout_marginStart=\"10dp\"\n                        android:text=\"Asia/Jakarta\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Seksi: Lampiran & impor -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingBottom=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_image\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Lampiran &amp; impor\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"BATAS\"\n                        android:textColor=\"@color/sf_muted_2\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Ukuran lampiran -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Ukuran maksimum lampiran\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"JPG/PNG untuk bukti batch dan penanganan.\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <EditText\n                            style=\"@style/SF.Input\"\n                            android:layout_width=\"57dp\"\n                            android:layout_height=\"34dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:gravity=\"center\"\n                            android:inputType=\"number\"\n                            android:minHeight=\"0dp\"\n                            android:padding=\"5dp\"\n                            android:text=\"2\"\n                            android:textSize=\"12sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginStart=\"5dp\"\n                            android:text=\"MB\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Maksimum baris impor -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingTop=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Maksimum baris impor\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:lineSpacingMultiplier=\"1.2\"\n                            android:text=\"Batas impor CSV pada backend Laravel.\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <EditText\n                            style=\"@style/SF.Input\"\n                            android:layout_width=\"57dp\"\n                            android:layout_height=\"34dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:gravity=\"center\"\n                            android:inputType=\"number\"\n                            android:minHeight=\"0dp\"\n                            android:padding=\"5dp\"\n                            android:text=\"1000\"\n                            android:textSize=\"12sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginStart=\"5dp\"\n                            android:text=\"baris\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Seksi: Kategori tetap -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingBottom=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_tag\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Kategori tetap\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"ENUM\"\n                        android:textColor=\"@color/sf_muted_2\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:text=\"Makanan\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"Minuman\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"Obat\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"6dp\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:text=\"Kebutuhan Rumah\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"Lainnya\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"9dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginStart=\"4dp\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Kategori disimpan sebagai enum pada kolom barang.kategori; tidak ada tabel kategori terpisah.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Seksi: Penjadwal -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingBottom=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_calendar_clock\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Penjadwal\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"SISTEM\"\n                        android:textColor=\"@color/sf_muted_2\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Notifikasi\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"06.00 &amp; 18.00 WIB\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"WorkManager\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"Setiap 12 jam\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingTop=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Anti-duplikat\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"1 baris / jenis / batch / hari\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- form-note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"10dp\"\n                android:paddingVertical=\"9dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_shield_check\"\n                    app:tint=\"@color/sf_info_ink\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"6dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Hanya pemilik yang dapat mengubah pengaturan. Perubahan dicatat sebagai ubah_pengaturan pada riwayat aktivitas.\"\n                    android:textColor=\"@color/sf_info_ink\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"11dp\"\n                    android:layout_height=\"11dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: pengaturan · ambang_peringatan_hari, maks_ukuran_lampiran_mb, maks_baris_impor\"\n                    android:textColor=\"@color/sf_muted_2\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Aksi bawah -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batal\" />\n\n        <TextView\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"8dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_save\"\n            android:text=\"Simpan pengaturan\" />\n    </LinearLayout>\n</LinearLayout>\n"
                                    }
                                }
                            }
                        }
                    ],
                    "fixes": [
                    ],
                    "partialFingerprints": {
                        "sourceContext/v1": "335046ebaf376653"
                    }
                },
                {
                    "ruleId": "UnusedResources",
                    "ruleIndex": 12,
                    "message": {
                        "text": "The resource R.layout.fragment_pengguna appears to be unused",
                        "markdown": "The resource `R.layout.fragment_pengguna` appears to be unused"
                    },
                    "locations": [
                        {
                            "physicalLocation": {
                                "artifactLocation": {
                                    "uriBaseId": "%SRCROOT%",
                                    "uri": "app/src/main/res/layout/fragment_pengguna.xml"
                                },
                                "region": {
                                    "startLine": 6,
                                    "startColumn": 1,
                                    "endLine": 366,
                                    "endColumn": 16,
                                    "charOffset": 222,
                                    "charLength": 14915,
                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:singleLine=\"true\"\n            android:text=\"Akun pengguna\"\n            android:textSize=\"18sp\" />\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:layout_marginStart=\"11dp\"\n            android:src=\"@drawable/ic_plus\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Metrik -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"2\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"total akun\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"2\"\n                        android:textColor=\"@color/sf_safe\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"aktif\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"1\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"staf\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Alert strip info -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_shield_check\"\n                    app:tint=\"@color/sf_info_ink\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                        android:text=\"Akun staf dibuat pemilik.\"\n                        android:textColor=\"@color/sf_info_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"1dp\"\n                        android:lineSpacingMultiplier=\"1.25\"\n                        android:text=\"Tidak ada registrasi mandiri. Menonaktifkan akun mencabut seluruh token Sanctum miliknya.\"\n                        android:textColor=\"@color/sf_info_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- User card: Budi Santoso (Anda) -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_14\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"11dp\">\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"40dp\"\n                    android:layout_height=\"40dp\"\n                    android:background=\"@drawable/bg_avatar\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                    android:gravity=\"center\"\n                    android:text=\"BS\"\n                    android:textColor=\"#17523A\"\n                    android:textSize=\"12sp\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"10dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:text=\"Budi Santoso\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"5dp\"\n                            android:background=\"@drawable/bg_pill_brand\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:paddingHorizontal=\"6dp\"\n                            android:paddingVertical=\"2dp\"\n                            android:text=\"Anda\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"10sp\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"2dp\"\n                        android:text=\"\\@pemilik · dibuat 30 Okt 2026\" />\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"5dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Pill.Brand\"\n                            android:text=\"Pemilik\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Safe\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"Aktif\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"10dp\"\n                    android:gravity=\"end\"\n                    android:orientation=\"vertical\">\n\n                    <ImageView\n                        style=\"@style/SF.IconBtn.Boxed\"\n                        android:src=\"@drawable/ic_edit\" />\n\n                    <com.google.android.material.materialswitch.MaterialSwitch\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"5dp\"\n                        android:checked=\"true\"\n                        android:enabled=\"false\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- User card: Rina Wulandari (staf) -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card_14\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"11dp\">\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"40dp\"\n                    android:layout_height=\"40dp\"\n                    android:background=\"@drawable/bg_avatar_staff\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                    android:gravity=\"center\"\n                    android:text=\"RW\"\n                    android:textColor=\"#294669\"\n                    android:textSize=\"12sp\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"10dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                        android:text=\"Rina Wulandari\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"2dp\"\n                        android:text=\"\\@staf · dibuat 30 Okt 2026\" />\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"5dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Pill.Info\"\n                            android:text=\"Staf\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Safe\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"Aktif\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"10dp\"\n                    android:gravity=\"end\"\n                    android:orientation=\"vertical\">\n\n                    <ImageView\n                        style=\"@style/SF.IconBtn.Boxed\"\n                        android:src=\"@drawable/ic_edit\" />\n\n                    <com.google.android.material.materialswitch.MaterialSwitch\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"5dp\"\n                        android:checked=\"true\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"11dp\"\n                    android:layout_height=\"11dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: users · peran pemilik/staf · aktif 0/1 · unique username\"\n                    android:textColor=\"@color/sf_muted_2\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n</LinearLayout>"
