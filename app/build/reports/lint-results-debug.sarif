e/bg_product_food\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cookie\"\n                            app:tint=\"#9A6515\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:text=\"Indomie Goreng\" />\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"4dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.BatchCode\"\n                                android:text=\"MGN-2411B\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_marginStart=\"5dp\"\n                                android:text=\"sisa 50 pcs\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Pill.Warn\"\n                            android:drawableStart=\"@drawable/ic12_clock\"\n                            android:text=\"Mendekati\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"30 hr lagi\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Stok menipis -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Stok menipis\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Stok tersedia ≤ stok minimum\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:padding=\"15dp\">\n\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingTop=\"0dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_home\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_droplet\"\n                            app:tint=\"#397A55\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:text=\"Sunlight 755ml\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.RowSub\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"5 / min. 15 pcs\" />\n\n                        <ProgressBar\n                            style=\"@style/SF.Progress.Warn\"\n                            android:layout_width=\"120dp\"\n                            android:layout_marginTop=\"7dp\"\n                            android:progress=\"33\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"8dp\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Menipis\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:paddingBottom=\"0dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_other\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_package\"\n                            app:tint=\"#66756C\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:text=\"Tisu Basah\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.RowSub\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"0 / min. 10 pack\" />\n\n                        <ProgressBar\n                            style=\"@style/SF.Progress.Warn\"\n                            android:layout_width=\"120dp\"\n                            android:layout_marginTop=\"7dp\"\n                            android:progress=\"0\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"8dp\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Menipis\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Aktivitas terbaru -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"bottom\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Section\"\n                        android:text=\"Aktivitas terbaru\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"Audit log pengguna\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Text.Link\"\n                    android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                    android:text=\"Lihat semua\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"15dp\"\n                android:paddingVertical=\"4dp\">\n\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:gravity=\"top\">\n\n                    <FrameLayout\n                        android:layout_width=\"30dp\"\n                        android:layout_height=\"30dp\"\n                        android:background=\"@drawable/bg_ic_violet\">\n\n                        <ImageView\n                            android:layout_width=\"14dp\"\n                            android:layout_height=\"14dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_settings\"\n                            app:tint=\"@color/sf_violet\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Atur ambang peringatan = 30 hari\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"pengaturan · Budi Santoso · Ubah pengaturan\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"13.05\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:gravity=\"top\">\n\n                    <FrameLayout\n                        android:layout_width=\"30dp\"\n                        android:layout_height=\"30dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"14dp\"\n                            android:layout_height=\"14dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_package_x\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Batch PRC-2410B dimusnahkan\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"batch #6 · Budi Santoso · Penanganan kedaluwarsa\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"11.30\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:gravity=\"top\">\n\n                    <FrameLayout\n                        android:layout_width=\"30dp\"\n                        android:layout_height=\"30dp\"\n                        android:background=\"@drawable/bg_ic_danger\">\n\n                        <ImageView\n                            android:layout_width=\"14dp\"\n                            android:layout_height=\"14dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_arrow_up_right\"\n                            app:tint=\"@color/sf_danger\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Keluar 19 pcs Sunlight (FEFO)\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"batch #7 · Rina Wulandari · Pengeluaran stok\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginStart=\"6dp\"\n                        android:text=\"10.12\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Sumber data -->\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_marginTop=\"16dp\"\n                android:drawableStart=\"@drawable/ic12_database\"\n                android:drawablePadding=\"4dp\"\n                android:drawableTint=\"#94A49C\"\n                android:text=\"Sumber: v_stok_tersedia · v_perlu_ditangani · seed 30 Okt 2026\"\n                android:textColor=\"#94A49C\"\n                android:textSize=\"9sp\" />\n        </LinearLayout>\n    </ScrollView>\n\n    <include\n        layout=\"@layout/view_tabbar_owner_beranda\"\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\" />\n</LinearLayout>"
