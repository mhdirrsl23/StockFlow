                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar tab utama -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"66dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <LinearLayout\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_weight=\"1\"\n            android:orientation=\"vertical\">\n\n            <TextView\n                style=\"@style/SF.Text.Title\"\n                android:singleLine=\"true\"\n                android:text=\"Barang\"\n                android:textSize=\"18sp\" />\n\n            <TextView\n                style=\"@style/SF.Text.Caption\"\n                android:layout_marginTop=\"3dp\"\n                android:singleLine=\"true\"\n                android:text=\"Master barang &amp; batch stok\" />\n        </LinearLayout>\n\n        <!-- Tambah barang -->\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_plus\" />\n\n        <!-- Notifikasi + badge -->\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"36dp\"\n            android:layout_marginStart=\"8dp\">\n\n            <ImageView\n                style=\"@style/SF.IconBtn\"\n                android:src=\"@drawable/ic_bell\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"16dp\"\n                android:layout_height=\"16dp\"\n                android:layout_gravity=\"top|end\"\n                android:background=\"@drawable/bg_badge\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:gravity=\"center\"\n                android:text=\"4\"\n                android:textColor=\"@color/sf_on_brand\"\n                android:textSize=\"8sp\" />\n        </FrameLayout>\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Segmented Barang / Batch -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:background=\"@drawable/bg_segmented\"\n                android:orientation=\"horizontal\"\n                android:padding=\"3dp\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"36dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_segment_active\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_box\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"6dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Barang\"\n                        android:textColor=\"@color/sf_brand\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"6dp\"\n                        android:background=\"@drawable/bg_pill_brand\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:paddingHorizontal=\"5dp\"\n                        android:paddingVertical=\"1dp\"\n                        android:text=\"5\"\n                        android:textColor=\"@color/sf_brand\"\n                        android:textSize=\"9sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"36dp\"\n                    android:layout_marginStart=\"3dp\"\n                    android:layout_weight=\"1\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_layers\"\n                        app:tint=\"#6C8176\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"6dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Batch\"\n                        android:textColor=\"#6C8176\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"6dp\"\n                        android:background=\"@drawable/bg_pill_muted\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:paddingHorizontal=\"5dp\"\n                        android:paddingVertical=\"1dp\"\n                        android:text=\"7\"\n                        android:textColor=\"@color/sf_muted\"\n                        android:textSize=\"9sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Pencarian -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"42dp\"\n                android:layout_marginTop=\"12dp\"\n                android:background=\"@drawable/bg_search\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"12dp\">\n\n                <ImageView\n                    android:layout_width=\"16dp\"\n                    android:layout_height=\"16dp\"\n                    android:src=\"@drawable/ic_search\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <EditText\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@null\"\n                    android:fontFamily=\"@font/plus_jakarta_sans\"\n                    android:hint=\"Cari nama, SKU, atau kategori…\"\n                    android:includeFontPadding=\"false\"\n                    android:inputType=\"text\"\n                    android:padding=\"0dp\"\n                    android:singleLine=\"true\"\n                    android:textColor=\"@color/sf_ink\"\n                    android:textColorHint=\"@color/sf_muted_2\"\n                    android:textSize=\"12sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"8dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"5 barang\" />\n            </LinearLayout>\n\n            <!-- Chip kategori -->\n            <HorizontalScrollView\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"12dp\"\n                android:scrollbars=\"none\">\n\n                <LinearLayout\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"1dp\"\n                    android:paddingBottom=\"3dp\">\n\n                    <TextView\n                        style=\"@style/SF.Chip.Active\"\n                        android:text=\"Semua\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Makanan\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Minuman\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Obat\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Kebutuhan Rumah\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Lainnya\" />\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"30dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:background=\"@drawable/bg_chip\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"12dp\">\n\n                        <View\n                            android:layout_width=\"6dp\"\n                            android:layout_height=\"6dp\"\n                            android:background=\"@drawable/dot_warn\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"5dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                            android:singleLine=\"true\"\n                            android:text=\"Stok menipis\"\n                            android:textColor=\"@color/sf_chip_text\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </HorizontalScrollView>\n\n            <!-- Peringatan stok menipis -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_warn\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"15dp\"\n                    android:layout_height=\"15dp\"\n                    android:src=\"@drawable/ic_alert_circle\"\n                    app:tint=\"@color/sf_warn_ink\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"2 barang di bawah minimum\"\n                        android:textColor=\"@color/sf_warn_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"2dp\"\n                        android:lineSpacingMultiplier=\"1.25\"\n                        android:text=\"Ketuk untuk menyaring barang yang perlu restok.\"\n                        android:textColor=\"@color/sf_warn_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginStart=\"4dp\"\n                    android:src=\"@drawable/ic_chevron_right\"\n                    app:tint=\"@color/sf_warn_ink\" />\n            </LinearLayout>\n\n            <!-- Header daftar -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Eyebrow\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:text=\"Master barang\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:text=\"5 dari 5\" />\n            </LinearLayout>\n\n            <!-- Daftar 5 barang -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card_14\"\n                android:orientation=\"vertical\"\n                android:paddingTop=\"2dp\"\n                android:paddingBottom=\"2dp\">\n\n                <!-- 1 Indomie Goreng -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_food\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cookie\"\n                            app:tint=\"#9A6515\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:singleLine=\"true\"\n                            android:ellipsize=\"end\"\n                            android:text=\"Indomie Goreng\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"3dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:text=\"SKU-MKN-001\"\n                                android:textColor=\"@color/sf_muted_2\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:ellipsize=\"end\"\n                                android:singleLine=\"true\"\n                                android:text=\" · Makanan · 150 pcs\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"bottom\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"150\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginStart=\"2dp\"\n                                android:paddingBottom=\"1dp\"\n                                android:text=\"pcs\"\n                                android:textColor=\"@color/sf_muted\"\n                                android:textSize=\"9sp\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Pill.Safe\"\n                            android:layout_marginTop=\"3dp\"\n                            android:drawableStart=\"@drawable/ic12_check_circle\"\n                            android:text=\"Aman\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n\n                <View\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"1dp\"\n                    android:layout_marginStart=\"45dp\"\n                    android:background=\"@color/sf_line\" />\n\n                <!-- 2 Ultra Milk -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_drink\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cup\"\n                            app:tint=\"#2C6B93\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:ellipsize=\"end\"\n                            android:singleLine=\"true\"\n                            android:text=\"Ultra Milk Full Cream 250ml\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"3dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:text=\"SKU-MNM-001\"\n                                android:textColor=\"@color/sf_muted_2\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:ellipsize=\"end\"\n                                android:singleLine=\"true\"\n                                android:text=\" · Minuman · 40 pcs\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"bottom\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"40\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginStart=\"2dp\"\n                                android:paddingBottom=\"1dp\"\n                                android:text=\"pcs\"\n                                android:textColor=\"@color/sf_muted\"\n                                android:textSize=\"9sp\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Pill.Safe\"\n                            android:layout_marginTop=\"3dp\"\n                            android:drawableStart=\"@drawable/ic12_check_circle\"\n                            android:text=\"Aman\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n\n                <View\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"1dp\"\n                    android:layout_marginStart=\"45dp\"\n                    android:background=\"@color/sf_line\" />\n\n                <!-- 3 Paracetamol -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_med\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_pill\"\n                            app:tint=\"#9D4D59\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:ellipsize=\"end\"\n                            android:singleLine=\"true\"\n                            android:text=\"Paracetamol 500mg\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"3dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:text=\"SKU-UBT-001\"\n                                android:textColor=\"@color/sf_muted_2\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:ellipsize=\"end\"\n                                android:singleLine=\"true\"\n                                android:text=\" · Obat · 20 box\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"bottom\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"20\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginStart=\"2dp\"\n                                android:paddingBottom=\"1dp\"\n                                android:text=\"box\"\n                                android:textColor=\"@color/sf_muted\"\n                                android:textSize=\"9sp\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Pill.Safe\"\n                            android:layout_marginTop=\"3dp\"\n                            android:drawableStart=\"@drawable/ic12_check_circle\"\n                            android:text=\"Aman\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n\n                <View\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"1dp\"\n                    android:layout_marginStart=\"45dp\"\n                    android:background=\"@color/sf_line\" />\n\n                <!-- 4 Sunlight -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_home\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_droplet\"\n                            app:tint=\"#397A55\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:ellipsize=\"end\"\n                            android:singleLine=\"true\"\n                            android:text=\"Sunlight 755ml\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"3dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:text=\"SKU-RMH-001\"\n                                android:textColor=\"@color/sf_muted_2\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:ellipsize=\"end\"\n                                android:singleLine=\"true\"\n                                android:text=\" · Kebutuhan Rumah · 5 pcs\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"bottom\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"5\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginStart=\"2dp\"\n                                android:paddingBottom=\"1dp\"\n                                android:text=\"pcs\"\n                                android:textColor=\"@color/sf_muted\"\n                                android:textSize=\"9sp\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Pill.Warn\"\n                            android:layout_marginTop=\"3dp\"\n                            android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                            android:text=\"Menipis\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n\n                <View\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"1dp\"\n                    android:layout_marginStart=\"45dp\"\n                    android:background=\"@color/sf_line\" />\n\n                <!-- 5 Tisu Basah -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_other\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_package\"\n                            app:tint=\"#66756C\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:ellipsize=\"end\"\n                            android:singleLine=\"true\"\n                            android:text=\"Tisu Basah\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"3dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:text=\"SKU-LNY-001\"\n                                android:textColor=\"@color/sf_muted_2\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:ellipsize=\"end\"\n                                android:singleLine=\"true\"\n                                android:text=\" · Lainnya · 0 pack\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"bottom\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"0\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginStart=\"2dp\"\n                                android:paddingBottom=\"1dp\"\n                                android:text=\"pack\"\n                                android:textColor=\"@color/sf_muted\"\n                                android:textSize=\"9sp\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Pill.Warn\"\n                            android:layout_marginTop=\"3dp\"\n                            android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                            android:text=\"Menipis\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- State kosong hasil pencarian (tidak tampil pada data seed) -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_empty\"\n                android:gravity=\"center\"\n                android:orientation=\"vertical\"\n                android:padding=\"20dp\"\n                android:visibility=\"gone\">\n\n                <FrameLayout\n                    android:layout_width=\"42dp\"\n                    android:layout_height=\"42dp\"\n                    android:background=\"@drawable/bg_ic_muted\">\n\n                    <ImageView\n                        android:layout_width=\"19dp\"\n                        android:layout_height=\"19dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_search\"\n                        app:tint=\"@color/sf_muted\" />\n                </FrameLayout>\n\n                <TextView\n                    style=\"@style/SF.Text.Strong\"\n                    android:layout_marginTop=\"9dp\"\n                    android:text=\"Hasil tidak ditemukan\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:gravity=\"center\"\n                    android:text=\"Coba kata kunci lain.\" />\n            </LinearLayout>\n\n            <!-- Catatan sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"13dp\"\n                    android:layout_height=\"13dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"6dp\"\n                    android:text=\"Sumber: view v_stok_tersedia · 5 baris barang aktif\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <include\n        layout=\"@layout/view_tabbar_owner_barang\"\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\" />\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 5,
                                    "endLine": 978,
                                    "snippet": {
                                        "text": "  Tab bar: Pemilik, tab Barang aktif.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar tab utama -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"66dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <LinearLayout\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_weight=\"1\"\n            android:orientation=\"vertical\">\n\n            <TextView\n                style=\"@style/SF.Text.Title\"\n                android:singleLine=\"true\"\n                android:text=\"Barang\"\n                android:textSize=\"18sp\" />\n\n            <TextView\n                style=\"@style/SF.Text.Caption\"\n                android:layout_marginTop=\"3dp\"\n                android:singleLine=\"true\"\n                android:text=\"Master barang &amp; batch stok\" />\n        </LinearLayout>\n\n        <!-- Tambah barang -->\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_plus\" />\n\n        <!-- Notifikasi + badge -->\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"36dp\"\n            android:layout_marginStart=\"8dp\">\n\n            <ImageView\n                style=\"@style/SF.IconBtn\"\n                android:src=\"@drawable/ic_bell\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"16dp\"\n                android:layout_height=\"16dp\"\n                android:layout_gravity=\"top|end\"\n                android:background=\"@drawable/bg_badge\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:gravity=\"center\"\n                android:text=\"4\"\n                android:textColor=\"@color/sf_on_brand\"\n                android:textSize=\"8sp\" />\n        </FrameLayout>\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Segmented Barang / Batch -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:background=\"@drawable/bg_segmented\"\n                android:orientation=\"horizontal\"\n                android:padding=\"3dp\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"36dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_segment_active\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_box\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"6dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Barang\"\n                        android:textColor=\"@color/sf_brand\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"6dp\"\n                        android:background=\"@drawable/bg_pill_brand\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:paddingHorizontal=\"5dp\"\n                        android:paddingVertical=\"1dp\"\n                        android:text=\"5\"\n                        android:textColor=\"@color/sf_brand\"\n                        android:textSize=\"9sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"36dp\"\n                    android:layout_marginStart=\"3dp\"\n                    android:layout_weight=\"1\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_layers\"\n                        app:tint=\"#6C8176\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"6dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Batch\"\n                        android:textColor=\"#6C8176\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"6dp\"\n                        android:background=\"@drawable/bg_pill_muted\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:paddingHorizontal=\"5dp\"\n                        android:paddingVertical=\"1dp\"\n                        android:text=\"7\"\n                        android:textColor=\"@color/sf_muted\"\n                        android:textSize=\"9sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Pencarian -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"42dp\"\n                android:layout_marginTop=\"12dp\"\n                android:background=\"@drawable/bg_search\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"12dp\">\n\n                <ImageView\n                    android:layout_width=\"16dp\"\n                    android:layout_height=\"16dp\"\n                    android:src=\"@drawable/ic_search\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <EditText\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@null\"\n                    android:fontFamily=\"@font/plus_jakarta_sans\"\n                    android:hint=\"Cari nama, SKU, atau kategori…\"\n                    android:includeFontPadding=\"false\"\n                    android:inputType=\"text\"\n                    android:padding=\"0dp\"\n                    android:singleLine=\"true\"\n                    android:textColor=\"@color/sf_ink\"\n                    android:textColorHint=\"@color/sf_muted_2\"\n                    android:textSize=\"12sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"8dp\"\n                    android:singleLine=\"true\"\n                    android:text=\"5 barang\" />\n            </LinearLayout>\n\n            <!-- Chip kategori -->\n            <HorizontalScrollView\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"12dp\"\n                android:scrollbars=\"none\">\n\n                <LinearLayout\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"1dp\"\n                    android:paddingBottom=\"3dp\">\n\n                    <TextView\n                        style=\"@style/SF.Chip.Active\"\n                        android:text=\"Semua\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Makanan\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Minuman\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Obat\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Kebutuhan Rumah\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Lainnya\" />\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"30dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:background=\"@drawable/bg_chip\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"12dp\">\n\n                        <View\n                            android:layout_width=\"6dp\"\n                            android:layout_height=\"6dp\"\n                            android:background=\"@drawable/dot_warn\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"5dp\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                            android:singleLine=\"true\"\n                            android:text=\"Stok menipis\"\n                            android:textColor=\"@color/sf_chip_text\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </HorizontalScrollView>\n\n            <!-- Peringatan stok menipis -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_warn\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"15dp\"\n                    android:layout_height=\"15dp\"\n                    android:src=\"@drawable/ic_alert_circle\"\n                    app:tint=\"@color/sf_warn_ink\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"2 barang di bawah minimum\"\n                        android:textColor=\"@color/sf_warn_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"2dp\"\n                        android:lineSpacingMultiplier=\"1.25\"\n                        android:text=\"Ketuk untuk menyaring barang yang perlu restok.\"\n                        android:textColor=\"@color/sf_warn_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginStart=\"4dp\"\n                    android:src=\"@drawable/ic_chevron_right\"\n                    app:tint=\"@color/sf_warn_ink\" />\n            </LinearLayout>\n\n            <!-- Header daftar -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Eyebrow\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:text=\"Master barang\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:text=\"5 dari 5\" />\n            </LinearLayout>\n\n            <!-- Daftar 5 barang -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card_14\"\n                android:orientation=\"vertical\"\n                android:paddingTop=\"2dp\"\n                android:paddingBottom=\"2dp\">\n\n                <!-- 1 Indomie Goreng -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_food\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cookie\"\n                            app:tint=\"#9A6515\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:singleLine=\"true\"\n                            android:ellipsize=\"end\"\n                            android:text=\"Indomie Goreng\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"3dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:text=\"SKU-MKN-001\"\n                                android:textColor=\"@color/sf_muted_2\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:ellipsize=\"end\"\n                                android:singleLine=\"true\"\n                                android:text=\" · Makanan · 150 pcs\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"bottom\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"150\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginStart=\"2dp\"\n                                android:paddingBottom=\"1dp\"\n                                android:text=\"pcs\"\n                                android:textColor=\"@color/sf_muted\"\n                                android:textSize=\"9sp\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Pill.Safe\"\n                            android:layout_marginTop=\"3dp\"\n                            android:drawableStart=\"@drawable/ic12_check_circle\"\n                            android:text=\"Aman\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_marginStart=\"7dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n\n                <View\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"1dp\"\n                    android:layout_marginStart=\"45dp\"\n                    android:background=\"@color/sf_line\" />\n\n                <!-- 2 Ultra Milk -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_drink\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cup\"\n                            app:tint=\"#2C6B93\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_