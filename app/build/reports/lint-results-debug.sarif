                                    "endLine": 405,
                                    "snippet": {
                                        "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<!-- Login — draft.html loginPage() / .auth. Tema gelap hijau, kartu kaca, akun data uji. -->\n<ScrollView xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@drawable/bg_auth\"\n    android:fillViewport=\"true\"\n    android:scrollbars=\"none\"\n    tools:ignore=\"HardcodedText,ContentDescription,Autofill,LabelFor\">\n\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:orientation=\"vertical\"\n        android:paddingStart=\"22dp\"\n        android:paddingTop=\"30dp\"\n        android:paddingEnd=\"22dp\"\n        android:paddingBottom=\"28dp\">\n\n        <!-- Brand -->\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginBottom=\"34dp\"\n            android:gravity=\"center_vertical\"\n            android:orientation=\"horizontal\">\n\n            <FrameLayout\n                android:layout_width=\"46dp\"\n                android:layout_height=\"46dp\"\n                android:background=\"@drawable/bg_auth_brand_mark\">\n\n                <ImageView\n                    android:layout_width=\"24dp\"\n                    android:layout_height=\"24dp\"\n                    android:layout_gravity=\"center\"\n                    android:src=\"@drawable/ic_layers\"\n                    app:tint=\"@color/sf_auth_mark\" />\n            </FrameLayout>\n\n            <LinearLayout\n                android:layout_width=\"wrap_content\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginStart=\"10dp\"\n                android:orientation=\"vertical\">\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                    android:text=\"StockFlow\"\n                    android:textColor=\"#F2FFF9\"\n                    android:textSize=\"16sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginTop=\"3dp\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:letterSpacing=\"0.14\"\n                    android:text=\"EDISI DATABASE\"\n                    android:textColor=\"#84B9A2\"\n                    android:textSize=\"9sp\" />\n            </LinearLayout>\n        </LinearLayout>\n\n        <TextView\n            style=\"@style/SF.Text\"\n            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n            android:letterSpacing=\"0.16\"\n            android:text=\"MANAJEMEN STOK &amp; KEDALUWARSA\"\n            android:textColor=\"@color/sf_auth_eyebrow\"\n            android:textSize=\"10sp\" />\n\n        <TextView\n            style=\"@style/SF.Text\"\n            android:layout_marginTop=\"8dp\"\n            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n            android:letterSpacing=\"-0.04\"\n            android:lineSpacingMultiplier=\"0.95\"\n            android:text=\"Masuk ke\\ngudang.\"\n            android:textColor=\"@color/sf_auth_text\"\n            android:textSize=\"34sp\" />\n\n        <TextView\n            style=\"@style/SF.Text\"\n            android:layout_width=\"300dp\"\n            android:layout_marginTop=\"10dp\"\n            android:lineSpacingMultiplier=\"1.25\"\n            android:text=\"Kelola barang, batch, mutasi, dan penanganan kedaluwarsa — sesuai skema stockflow_database.sql.\"\n            android:textColor=\"@color/sf_auth_lede\"\n            android:textSize=\"12sp\" />\n\n        <!-- Kartu kaca -->\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginTop=\"25dp\"\n            android:background=\"@drawable/bg_auth_card\"\n            android:orientation=\"vertical\"\n            android:padding=\"15dp\">\n\n            <!-- Username -->\n            <TextView\n                style=\"@style/SF.Text.Label\"\n                android:text=\"Username *\"\n                android:textColor=\"@color/sf_auth_label\" />\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"44dp\"\n                android:layout_marginTop=\"5dp\"\n                android:background=\"@drawable/bg_auth_input\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\">\n\n                <ImageView\n                    android:layout_width=\"16dp\"\n                    android:layout_height=\"16dp\"\n                    android:src=\"@drawable/ic_user\"\n                    app:tint=\"@color/sf_auth_icon\" />\n\n                <EditText\n                    android:id=\"@+id/et_username\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@null\"\n                    android:hint=\"pemilik atau staf\"\n                    android:inputType=\"text\"\n                    android:singleLine=\"true\"\n                    android:textColor=\"@color/sf_auth_text\"\n                    android:textColorHint=\"@color/sf_auth_hint\"\n                    android:textSize=\"13sp\" />\n            </LinearLayout>\n\n            <!-- Kata sandi -->\n            <TextView\n                style=\"@style/SF.Text.Label\"\n                android:layout_marginTop=\"12dp\"\n                android:text=\"Kata sandi *\"\n                android:textColor=\"@color/sf_auth_label\" />\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"44dp\"\n                android:layout_marginTop=\"5dp\"\n                android:background=\"@drawable/bg_auth_input\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingStart=\"11dp\"\n                android:paddingEnd=\"5dp\">\n\n                <ImageView\n                    android:layout_width=\"16dp\"\n                    android:layout_height=\"16dp\"\n                    android:src=\"@drawable/ic_lock\"\n                    app:tint=\"@color/sf_auth_icon\" />\n\n                <EditText\n                    android:id=\"@+id/et_password\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@null\"\n                    android:hint=\"password\"\n                    android:inputType=\"textPassword\"\n                    android:singleLine=\"true\"\n                    android:textColor=\"@color/sf_auth_text\"\n                    android:textColorHint=\"@color/sf_auth_hint\"\n                    android:textSize=\"13sp\" />\n\n                <ImageView\n                    android:id=\"@+id/btn_toggle_password\"\n                    style=\"@style/SF.IconBtn\"\n                    android:layout_width=\"32dp\"\n                    android:layout_height=\"32dp\"\n                    android:padding=\"8dp\"\n                    android:src=\"@drawable/ic_eye\"\n                    app:tint=\"@color/sf_auth_icon\" />\n            </LinearLayout>\n\n            <!-- Tombol Masuk -->\n            <TextView\n                android:id=\"@+id/btn_masuk\"\n                style=\"@style/SF.Btn.Primary\"\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"46dp\"\n                android:layout_marginTop=\"14dp\"\n                android:drawableStart=\"@drawable/ic_login\"\n                android:text=\"Masuk\" />\n\n            <!-- Pemisah -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"15dp\"\n                android:layout_marginBottom=\"3dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\">\n\n                <View\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"1dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"#26B7E3CB\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginHorizontal=\"8dp\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:letterSpacing=\"0.1\"\n                    android:text=\"AKUN DATA UJI\"\n                    android:textColor=\"@color/sf_auth_foot\"\n                    android:textSize=\"9sp\" />\n\n                <View\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"1dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"#26B7E3CB\" />\n            </LinearLayout>\n\n            <!-- Demo: pemilik -->\n            <LinearLayout\n                android:id=\"@+id/demo_pemilik\"\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"7dp\"\n                android:background=\"@drawable/bg_auth_demo\"