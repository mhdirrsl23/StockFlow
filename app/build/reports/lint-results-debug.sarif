                                    "endLine": 559,
                                    "snippet": {
                                        "text": "  Angka: aktivitas saya = 4 (riwayat user_id 1), batch saya = 4 (MGN-2411A/B, PRC-2410A/B), akun = 2.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar tab utama (tanpa aksi) -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"66dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <LinearLayout\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_weight=\"1\"\n            android:orientation=\"vertical\">\n\n            <TextView\n                style=\"@style/SF.Text.Title\"\n                android:singleLine=\"true\"\n                android:text=\"Profil\"\n                android:textSize=\"18sp\" />\n\n            <TextView\n                style=\"@style/SF.Text.Caption\"\n                android:layout_marginTop=\"3dp\"\n                android:singleLine=\"true\"\n                android:text=\"Akun &amp; preferensi\" />\n        </LinearLayout>\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Profile hero -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:background=\"@drawable/bg_card_tint\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"15dp\">\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"58dp\"\n                    android:layout_height=\"58dp\"\n                    android:background=\"@drawable/bg_avatar_lg\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                    android:gravity=\"center\"\n                    android:text=\"BS\"\n                    android:textColor=\"#17523A\"\n                    android:textSize=\"19sp\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"12dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:text=\"Budi Santoso\"\n                        android:textSize=\"16sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.RowSub\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"\\@pemilik · akun aktif\" />\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"7dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Pill.Brand\"\n                            android:text=\"Pemilik\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Safe\"\n                            android:layout_marginStart=\"5dp\"\n                            android:drawableStart=\"@drawable/ic12_check_circle\"\n                            android:text=\"Aktif\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Statistik -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:gravity=\"center_horizontal\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.03\"\n                        android:text=\"4\"\n                        android:textSize=\"16sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"aktivitas saya\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:gravity=\"center_horizontal\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.03\"\n                        android:text=\"4\"\n                        android:textSize=\"16sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"batch saya\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:gravity=\"center_horizontal\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:letterSpacing=\"-0.03\"\n                        android:text=\"2\"\n                        android:textSize=\"16sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"akun pengguna\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Kelola -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Kelola\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Menu sesuai peran akun\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\">\n\n                <!-- Akun pengguna -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_mint\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_users\"\n                            app:tint=\"@color/sf_brand\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Akun pengguna\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"Pemilik &amp; staf · aktif/nonaktif\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"10dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Pengaturan -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_mint\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_settings\"\n                            app:tint=\"@color/sf_brand\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Pengaturan\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"Ambang kedaluwarsa, lampiran, impor\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"10dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Notifikasi -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_bell\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Notifikasi\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"4 belum ditampilkan\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Danger\"\n                        android:layout_marginStart=\"10dp\"\n                        android:text=\"4\" />\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"10dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- Data & skema -->\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_info\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_database\"\n                            app:tint=\"@color/sf_info\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Data &amp; skema\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"9 tabel · 2 view · ekspor JSON\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"10dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Akun -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Akun\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Sesi dan keamanan\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\">\n\n                <LinearLayout\n                    style=\"@style/SF.Row\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_danger\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_logout\"\n                            app:tint=\"@color/sf_danger\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Keluar &amp; ganti akun\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"Kembali ke layar masuk\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"10dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Owner note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_alert_warn\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"10dp\"\n                android:paddingVertical=\"9dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_info\"\n                    app:tint=\"@color/sf_warn_ink\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"7dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Data uji memakai kata sandi password untuk kedua akun. Di Laravel, kata sandi disimpan sebagai hash bcrypt dan token Sanctum dicabut saat akun dinonaktifkan.\"\n                    android:textColor=\"@color/sf_warn_ink\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n\n            <!-- Footer brand -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_horizontal\"\n                android:orientation=\"vertical\"\n                android:paddingTop=\"10dp\"\n                android:paddingBottom=\"2dp\">\n\n                <LinearLayout\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <FrameLayout\n                        android:layout_width=\"28dp\"\n                        android:layout_height=\"28dp\"\n                        android:background=\"@drawable/bg_brand_mark\">\n\n                        <ImageView\n                            android:layout_width=\"14dp\"\n                            android:layout_height=\"14dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_layers\"\n                            app:tint=\"#D9F7E8\" />\n                    </FrameLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"12dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                        android:text=\"StockFlow · Edisi Database\"\n                        android:textColor=\"@color/sf_muted\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"5dp\"\n                    android:text=\"v1.0 · 30 Oktober 2026 · dari stockflow_database.sql\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <include\n        layout=\"@layout/view_tabbar_owner_profil\"\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\" />\n</LinearLayout>\n"
