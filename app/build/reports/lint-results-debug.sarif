                           android:layout_width=\"29dp\"\n                            android:layout_height=\"29dp\"\n                            android:background=\"@drawable/bg_schema_ic\">\n\n                            <ImageView\n                                android:layout_width=\"14dp\"\n                                android:layout_height=\"14dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_bell\"\n                                app:tint=\"#587368\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:letterSpacing=\"-0.03\"\n                                android:text=\"notifikasi\"\n                                android:textSize=\"11sp\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"Peringatan harian untuk Android\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"9dp\"\n                            android:background=\"@drawable/bg_schema_count\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:paddingHorizontal=\"8dp\"\n                            android:paddingVertical=\"3dp\"\n                            android:text=\"4\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View\n                        style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:orientation=\"vertical\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingBottom=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"jenis\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"barang_id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"batch_id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"pesan\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"tanggal\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"ditampilkan_pada\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"created_at\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n\n                <!-- pengaturan -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"7dp\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingVertical=\"10dp\">\n\n                        <FrameLayout\n                            android:layout_width=\"29dp\"\n                            android:layout_height=\"29dp\"\n                            android:background=\"@drawable/bg_schema_ic\">\n\n                            <ImageView\n                                android:layout_width=\"14dp\"\n                                android:layout_height=\"14dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_settings\"\n                                app:tint=\"#587368\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:letterSpacing=\"-0.03\"\n                                android:text=\"pengaturan\"\n                                android:textSize=\"11sp\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"Key-value pengaturan\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"9dp\"\n                            android:background=\"@drawable/bg_schema_count\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:paddingHorizontal=\"8dp\"\n                            android:paddingVertical=\"3dp\"\n                            android:text=\"3\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View\n                        style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:orientation=\"vertical\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingBottom=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"kunci\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"nilai\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"updated_at\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n\n                <!-- personal_access_tokens -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"7dp\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingVertical=\"10dp\">\n\n                        <FrameLayout\n                            android:layout_width=\"29dp\"\n                            android:layout_height=\"29dp\"\n                            android:background=\"@drawable/bg_schema_ic\">\n\n                            <ImageView\n                                android:layout_width=\"14dp\"\n                                android:layout_height=\"14dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_key\"\n                                app:tint=\"#587368\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:letterSpacing=\"-0.03\"\n                                android:text=\"personal_access_tokens\"\n                                android:textSize=\"11sp\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"Token Sanctum (0 di mockup)\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"9dp\"\n                            android:background=\"@drawable/bg_pill_muted\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:paddingHorizontal=\"8dp\"\n                            android:paddingVertical=\"3dp\"\n                            android:text=\"0\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View\n                        style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:orientation=\"vertical\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingBottom=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"tokenable_type\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"tokenable_id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"name\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"token\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"abilities\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"expires_at\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"View\"\n                    android:textSize=\"13sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Dihitung langsung dari data live\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:orientation=\"vertical\">\n\n                <!-- v_stok_tersedia -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"0dp\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingVertical=\"10dp\">\n\n                        <FrameLayout\n                            android:layout_width=\"29dp\"\n                            android:layout_height=\"29dp\"\n                            android:background=\"@drawable/bg_schema_ic\">\n\n                            <ImageView\n                                android:layout_width=\"14dp\"\n                                android:layout_height=\"14dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_chart\"\n                                app:tint=\"#587368\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:letterSpacing=\"-0.03\"\n                                android:text=\"v_stok_tersedia\"\n                                android:textSize=\"11sp\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"SUM(jumlah_sisa) batch belum kedaluwarsa &amp; belum ditangani\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"9dp\"\n                            android:background=\"@drawable/bg_schema_count\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:paddingHorizontal=\"8dp\"\n                            android:paddingVertical=\"3dp\"\n                            android:text=\"5\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View\n                        style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:orientation=\"vertical\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingBottom=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"barang_id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"kode_sku\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"nama\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"total_stok_tersedia\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"status_stok\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n\n                <!-- v_perlu_ditangani -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"7dp\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingVertical=\"10dp\">\n\n                        <FrameLayout\n                            android:layout_width=\"29dp\"\n                            android:layout_height=\"29dp\"\n                            android:background=\"@drawable/bg_schema_ic\">\n\n                            <ImageView\n                                android:layout_width=\"14dp\"\n                                android:layout_height=\"14dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_alert_triangle\"\n                                app:tint=\"#587368\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:letterSpacing=\"-0.03\"\n                                android:text=\"v_perlu_ditangani\"\n                                android:textSize=\"11sp\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"Batch Kedaluwarsa yang belum Ditangani\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"9dp\"\n                            android:background=\"@drawable/bg_schema_count\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:paddingHorizontal=\"8dp\"\n                            android:paddingVertical=\"3dp\"\n                            android:text=\"1\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View\n                        style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:orientation=\"vertical\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingBottom=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"batch_id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"barang_id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"nama_barang\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"nomor_batch\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"jumlah_sisa\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"tanggal_kedaluwarsa\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"sisa_hari\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Aturan penting\"\n                    android:textSize=\"13sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Konsistensi dengan SQL\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:padding=\"15dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"0dp\"\n                        android:orientation=\"horizontal\">\n\n                        <ImageView\n                            android:layout_width=\"13dp\"\n                            android:layout_height=\"13dp\"\n                            android:layout_marginTop=\"1dp\"\n                            android:src=\"@drawable/ic_check_circle\"\n                            app:tint=\"@color/sf_brand\" />\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"7dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"Stok tersedia\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"11sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginTop=\"1dp\"\n                                android:lineSpacingMultiplier=\"1.3\"\n                                android:text=\"= Σ jumlah_sisa batch dengan tanggal_kedaluwarsa ≥ hari ini dan status ≠ Ditangani.\"\n                                android:textColor=\"#556B5F\"\n                                android:textSize=\"11sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <ImageView\n                            android:layout_width=\"13dp\"\n                            android:layout_height=\"13dp\"\n                            android:layout_marginTop=\"1dp\"\n                            android:src=\"@drawable/ic_check_circle\"\n                            app:tint=\"@color/sf_brand\" />\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"7dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"Status\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"11sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginTop=\"1dp\"\n                                android:lineSpacingMultiplier=\"1.3\"\n                                android:text=\"dihitung dari sisa hari: &lt;0 Kedaluwarsa, 0–30 Mendekati, &gt;30 Aman; Ditangani manual.\"\n                                android:textColor=\"#556B5F\"\n                                android:textSize=\"11sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <ImageView\n                            android:layout_width=\"13dp\"\n                            android:layout_height=\"13dp\"\n                            android:layout_marginTop=\"1dp\"\n                            android:src=\"@drawable/ic_check_circle\"\n                            app:tint=\"@color/sf_brand\" />\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"7dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"FEFO\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"11sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginTop=\"1dp\"\n                                android:lineSpacingMultiplier=\"1.3\"\n                                android:text=\"memakai urutan tanggal_kedaluwarsa; satu pengeluaran dapat menghasilkan beberapa baris mutasi keluar.\"\n                                android:textColor=\"#556B5F\"\n                                android:textSize=\"11sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <ImageView\n                            android:layout_width=\"13dp\"\n                            android:layout_height=\"13dp\"\n                            android:layout_marginTop=\"1dp\"\n                            android:src=\"@drawable/ic_check_circle\"\n                            app:tint=\"@color/sf_brand\" />\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"7dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"Soft delete\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"11sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginTop=\"1dp\"\n                                android:lineSpacingMultiplier=\"1.3\"\n                                android:text=\"memakai deleted_at + deleted_by; SKU dan nomor batch hanya unik di antara data aktif.\"\n                                android:textColor=\"#556B5F\"\n                                android:textSize=\"11sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <ImageView\n                            android:layout_width=\"13dp\"\n                            android:layout_height=\"13dp\"\n                            android:layout_marginTop=\"1dp\"\n                            android:src=\"@drawable/ic_info\"\n                            app:tint=\"@color/sf_brand\" />\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"7dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"Tidak ada harga.\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"11sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginTop=\"1dp\"\n                                android:lineSpacingMultiplier=\"1.3\"\n                                android:text=\"Skema hanya mencatat kuantitas, satuan, batch, mutasi, dan kedaluwarsa.\"\n                                android:textColor=\"#556B5F\"\n                                android:textSize=\"11sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n            </LinearLayout>\n\n            <!-- Aksi -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"18dp\"\n                android:orientation=\"horizontal\">\n\n                <TextView\n                    style=\"@style/SF.Btn.Ghost\"\n                    android:layout_width=\"0dp\"\n                    android:layout_weight=\"1\"\n                    android:drawableStart=\"@drawable/ic12_download\"\n                    android:text=\"Unduh JSON\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"44dp\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_btn_danger_soft\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:src=\"@drawable/ic_refresh\"\n                        app:tint=\"@color/sf_danger\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"7dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Reset data\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"13sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Catatan sumber -->\n            <TextView\n                style=\"@style/SF.Text.Caption\"\n                android:layout_marginTop=\"16dp\"\n                android:drawableStart=\"@drawable/ic12_database\"\n                android:drawablePadding=\"4dp\"\n                android:drawableTint=\"@color/sf_muted_2\"\n                android:padding=\"2dp\"\n                android:text=\"Sumber: stockflow_database.sql · 10 tabel (termasuk Sanctum) &amp; 2 view · data uji relatif hari ini\"\n                android:textColor=\"@color/sf_muted_2\" />\n\n        </LinearLayout>\n    </ScrollView>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 3,
                                    "endLine": 1977,
                                    "snippet": {
                                        "text": "  Data &amp; skema — draft.html dataPage(). Statis, tanpa tabbar.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <LinearLayout\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:orientation=\"vertical\">\n\n            <TextView\n                style=\"@style/SF.Text.Title\"\n                android:ellipsize=\"end\"\n                android:singleLine=\"true\"\n                android:text=\"Data &amp; skema\"\n                android:textSize=\"18sp\" />\n        </LinearLayout>\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Hero -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"horizontal\">\n\n                <FrameLayout\n                    android:layout_width=\"44dp\"\n                    android:layout_height=\"44dp\"\n                    android:background=\"@drawable/bg_ic_info\">\n\n                    <ImageView\n                        android:layout_width=\"20dp\"\n                        android:layout_height=\"20dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_database\"\n                        app:tint=\"@color/sf_info\" />\n                </FrameLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"12dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:text=\"Data &amp; skema\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"stockflow_database.sql · 399 baris · MySQL 8 / Laravel\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Ringkasan skema -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"0dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:gravity=\"center_horizontal\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:text=\"9\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:text=\"tabel\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:gravity=\"center_horizontal\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:text=\"2\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:text=\"view\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"7dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:gravity=\"center_horizontal\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:text=\"37\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:text=\"baris data\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Alert info -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_info\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                        android:text=\"UI mengikuti data, bukan angka rekaan.\"\n                        android:textColor=\"@color/sf_info_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"1dp\"\n                        android:lineSpacingMultiplier=\"1.25\"\n                        android:text=\"5 barang, 7 batch, 9 mutasi, 4 notifikasi, dan 2 akun berasal langsung dari seeder. Tidak ada kolom harga atau scan pada skema.\"\n                        android:textColor=\"@color/sf_info_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Tabel\"\n                    android:textSize=\"13sp\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Klik untuk melihat kolom kunci\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:orientation=\"vertical\">\n\n                <!-- users -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"0dp\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingVertical=\"10dp\">\n\n                        <FrameLayout\n                            android:layout_width=\"29dp\"\n                            android:layout_height=\"29dp\"\n                            android:background=\"@drawable/bg_schema_ic\">\n\n                            <ImageView\n                                android:layout_width=\"14dp\"\n                                android:layout_height=\"14dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_users\"\n                                app:tint=\"#587368\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:letterSpacing=\"-0.03\"\n                                android:text=\"users\"\n                                android:textSize=\"11sp\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"Akun pemilik &amp; staf\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"9dp\"\n                            android:background=\"@drawable/bg_schema_count\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:paddingHorizontal=\"8dp\"\n                            android:paddingVertical=\"3dp\"\n                            android:text=\"2\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View\n                        style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:orientation=\"vertical\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingBottom=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"nama\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"username\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"password\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"peran\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"aktif\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"remember_token\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"created_at\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"updated_at\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n\n                <!-- barang -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"7dp\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingVertical=\"10dp\">\n\n                        <FrameLayout\n                            android:layout_width=\"29dp\"\n                            android:layout_height=\"29dp\"\n                            android:background=\"@drawable/bg_schema_ic\">\n\n                            <ImageView\n                                android:layout_width=\"14dp\"\n                                android:layout_height=\"14dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_box\"\n                                app:tint=\"#587368\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:letterSpacing=\"-0.03\"\n                                android:text=\"barang\"\n                                android:textSize=\"11sp\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"Master barang aktif\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"9dp\"\n                            android:background=\"@drawable/bg_schema_count\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:paddingHorizontal=\"8dp\"\n                            android:paddingVertical=\"3dp\"\n                            android:text=\"5\"\n                            android:textColor=\"@color/sf_brand\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n\n                    <View\n                        style=\"@style/SF.Divider\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:orientation=\"vertical\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingBottom=\"11dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"9dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"id\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"kode_sku\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"nama\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"kategori\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"satuan\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"stok_minimum\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"created_by\"\n                            android:textStyle=\"normal\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"4dp\"\n                            android:text=\"deleted_by\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"4dp\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text.BatchCode\"\n                            android:layout_marginStart=\"0dp\"\n                            android:text=\"deleted_at\"\n                            android:textStyle=\"normal\" />\n                    </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n\n                <!-- batch_stok -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"7dp\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\"\n                        android:paddingHorizontal=\"11dp\"\n                        android:paddingVertical=\"10dp\">\n\n                        <FrameLayout\n                            android:layout_width=\"29dp\"\n                            android:layout_height=\"29dp\"\n                            android:background=\"@drawable/bg_schema_ic\">\n\n                            <ImageView\n                                android:layout_width=\"14dp\"\n                                android:layout_height=\"14dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_layers\"\n                                app:tint=\"#587368\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:letterSpacing=\"-0.03\"\n                                android:text=\"batch_stok\"\n                                android:textSize=\"11sp\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                           