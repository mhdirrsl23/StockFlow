                                    "charLength": 2915,
                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"68dp\"\n    android:background=\"@drawable/bg_tabbar\"\n    android:orientation=\"horizontal\"\n    android:paddingHorizontal=\"12dp\"\n    android:paddingTop=\"6dp\"\n    android:paddingBottom=\"8dp\"\n    tools:ignore=\"HardcodedText,ContentDescription\">\n\n    <LinearLayout\n        android:id=\"@+id/tab_beranda\"\n        style=\"@style/SF.Tab\">\n\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"27dp\">\n\n            <ImageView\n                android:layout_width=\"19dp\"\n                android:layout_height=\"19dp\"\n                android:layout_gravity=\"center\"\n                android:src=\"@drawable/ic_home\"\n                app:tint=\"@color/sf_tab_off\" />\n        </FrameLayout>\n\n        <TextView\n            style=\"@style/SF.Tab.Label\"\n            android:text=\"Beranda\" />\n    </LinearLayout>\n\n    <LinearLayout\n        android:id=\"@+id/tab_barang\"\n        style=\"@style/SF.Tab\">\n\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"27dp\"\n            android:background=\"@drawable/bg_tab_active\">\n\n            <ImageView\n                android:layout_width=\"19dp\"\n                android:layout_height=\"19dp\"\n                android:layout_gravity=\"center\"\n                android:src=\"@drawable/ic_box\"\n                app:tint=\"@color/sf_brand\" />\n        </FrameLayout>\n\n        <TextView\n            style=\"@style/SF.Tab.Label.Active\"\n            android:text=\"Barang\" />\n    </LinearLayout>\n\n    <LinearLayout\n        android:id=\"@+id/tab_laporan\"\n        style=\"@style/SF.Tab\">\n\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"27dp\">\n\n            <ImageView\n                android:layout_width=\"19dp\"\n                android:layout_height=\"19dp\"\n                android:layout_gravity=\"center\"\n                android:src=\"@drawable/ic_chart\"\n                app:tint=\"@color/sf_tab_off\" />\n        </FrameLayout>\n\n        <TextView\n            style=\"@style/SF.Tab.Label\"\n            android:text=\"Laporan\" />\n    </LinearLayout>\n\n    <LinearLayout\n        android:id=\"@+id/tab_profil\"\n        style=\"@style/SF.Tab\">\n\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"27dp\">\n\n            <ImageView\n                android:layout_width=\"19dp\"\n                android:layout_height=\"19dp\"\n                android:layout_gravity=\"center\"\n                android:src=\"@drawable/ic_user\"\n                app:tint=\"@color/sf_tab_off\" />\n        </FrameLayout>\n\n        <TextView\n            style=\"@style/SF.Tab.Label\"\n            android:text=\"Profil\" />\n    </LinearLayout>\n</LinearLayout>"
                                    }
