                                "contextRegion": {
                                    "startLine": 4,
                                    "endLine": 1401,
                                    "snippet": {
                                        "text": "  Data contoh = seed stockflow_database.sql (30 Okt 2026). Tab aktif: Beranda (tabbar staf).\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar brand -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"66dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <FrameLayout\n            android:layout_width=\"34dp\"\n            android:layout_height=\"34dp\"\n            android:background=\"@drawable/bg_brand_mark\">\n\n            <ImageView\n                android:layout_width=\"18dp\"\n                android:layout_height=\"18dp\"\n                android:layout_gravity=\"center\"\n                android:src=\"@drawable/ic_layers\"\n                app:tint=\"#D9F7E8\" />\n        </FrameLayout>\n\n        <LinearLayout\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"9dp\"\n            android:layout_weight=\"1\"\n            android:orientation=\"vertical\">\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:text=\"StockFlow\"\n                android:textColor=\"@color/sf_ink\"\n                android:textSize=\"16sp\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_marginTop=\"2dp\"\n                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                android:letterSpacing=\"0.11\"\n                android:text=\"EDISI DATABASE\"\n                android:textColor=\"@color/sf_muted\"\n                android:textSize=\"9sp\" />\n        </LinearLayout>\n\n        <!-- Notifikasi + badge -->\n        <FrameLayout\n            android:layout_width=\"36dp\"\n            android:layout_height=\"36dp\">\n\n            <ImageView\n                style=\"@style/SF.IconBtn\"\n                android:src=\"@drawable/ic_bell\" />\n\n            <TextView\n                style=\"@style/SF.Text\"\n                android:layout_width=\"16dp\"\n                android:layout_height=\"16dp\"\n                android:layout_gravity=\"top|end\"\n                android:background=\"@drawable/bg_badge\"\n                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                android:gravity=\"center\"\n                android:text=\"4\"\n                android:textColor=\"@color/sf_on_brand\"\n                android:textSize=\"8sp\" />\n        </FrameLayout>\n\n        <TextView\n            style=\"@style/SF.Text\"\n            android:layout_width=\"33dp\"\n            android:layout_height=\"33dp\"\n            android:layout_marginStart=\"7dp\"\n            android:background=\"@drawable/bg_avatar_staff\"\n            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n            android:gravity=\"center\"\n            android:text=\"RW\"\n            android:textColor=\"#294669\"\n            android:textSize=\"11sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Sapaan -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Heading\"\n                        android:text=\"Halo, Rina\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"Tugas stok yang perlu diselesaikan hari ini.\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"12dp\"\n                    android:background=\"@drawable/bg_date_chip\"\n                    android:drawableStart=\"@drawable/ic12_calendar\"\n                    android:drawablePadding=\"5dp\"\n                    android:drawableTint=\"#61776C\"\n                    android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                    android:paddingHorizontal=\"9dp\"\n                    android:paddingVertical=\"6dp\"\n                    android:text=\"Jum, 30 Okt\"\n                    android:textColor=\"#61776C\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n\n            <!-- Hero pemilik -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_hero_staff\">\n\n                <View\n                    android:layout_width=\"180dp\"\n                    android:layout_height=\"180dp\"\n                    android:layout_gravity=\"top|end\"\n                    android:layout_marginTop=\"-80dp\"\n                    android:layout_marginEnd=\"-76dp\"\n                    android:background=\"@drawable/bg_hero_orbit_staff\" />\n\n                <View\n                    android:layout_width=\"110dp\"\n                    android:layout_height=\"110dp\"\n                    android:layout_gravity=\"top|end\"\n                    android:layout_marginTop=\"-40dp\"\n                    android:layout_marginEnd=\"-34dp\"\n                    android:background=\"@drawable/bg_hero_orbit_staff\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"vertical\"\n                    android:paddingHorizontal=\"18dp\"\n                    android:paddingTop=\"17dp\"\n                    android:paddingBottom=\"16dp\">\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:gravity=\"center_vertical\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_width=\"0dp\"\n                            android:layout_weight=\"1\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                            android:letterSpacing=\"0.12\"\n                            android:text=\"TUGAS HARI INI\"\n                            android:textColor=\"#AED3E8\"\n                            android:textSize=\"9sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:text=\"Jum, 30 Okt\"\n                            android:textColor=\"#B3D4E5\"\n                            android:textSize=\"10sp\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"15dp\"\n                        android:gravity=\"bottom\"\n                        android:orientation=\"horizontal\">\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:text=\"Batch kedaluwarsa\"\n                                android:textColor=\"#B3D4E5\"\n                                android:textSize=\"11sp\" />\n\n                            <LinearLayout\n                                android:layout_width=\"wrap_content\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginTop=\"4dp\"\n                                android:baselineAligned=\"true\"\n                                android:orientation=\"horizontal\">\n\n                                <TextView\n                                    style=\"@style/SF.Text\"\n                                    android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                    android:letterSpacing=\"-0.05\"\n                                    android:text=\"1\"\n                                    android:textColor=\"@color/sf_on_brand\"\n                                    android:textSize=\"40sp\" />\n\n                                <TextView\n                                    style=\"@style/SF.Text\"\n                                    android:layout_gravity=\"bottom\"\n                                    android:layout_marginStart=\"5dp\"\n                                    android:layout_marginBottom=\"5dp\"\n                                    android:text=\"batch\"\n                                    android:textColor=\"#B3D4E5\"\n                                    android:textSize=\"11sp\" />\n                            </LinearLayout>\n                        </LinearLayout>\n\n                        <FrameLayout\n                            android:layout_width=\"60dp\"\n                            android:layout_height=\"60dp\"\n                            android:background=\"@drawable/bg_hero_orbit_staff\">\n\n                            <ImageView\n                                android:layout_width=\"22dp\"\n                                android:layout_height=\"22dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_clipboard_check\"\n                                app:tint=\"#C3E6F7\" />\n                        </FrameLayout>\n                    </LinearLayout>\n\n                    <View\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"1dp\"\n                        android:layout_marginTop=\"17dp\"\n                        android:background=\"#1FFFFFFF\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"13dp\"\n                        android:orientation=\"horizontal\">\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"3\"\n                                android:textColor=\"@color/sf_on_brand\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginTop=\"3dp\"\n                                android:text=\"mendekati\"\n                                android:textColor=\"#B3D4E5\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n\n                        <View\n                            android:layout_width=\"1dp\"\n                            android:layout_height=\"match_parent\"\n                            android:background=\"#1FFFFFFF\" />\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\"\n                            android:paddingStart=\"12dp\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"2\"\n                                android:textColor=\"@color/sf_on_brand\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginTop=\"3dp\"\n                                android:text=\"stok menipis\"\n                                android:textColor=\"#B3D4E5\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n\n                        <View\n                            android:layout_width=\"1dp\"\n                            android:layout_height=\"match_parent\"\n                            android:background=\"#1FFFFFFF\" />\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\"\n                            android:paddingStart=\"12dp\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"4\"\n                                android:textColor=\"@color/sf_on_brand\"\n                                android:textSize=\"14sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_marginTop=\"3dp\"\n                                android:text=\"notifikasi baru\"\n                                android:textColor=\"#B3D4E5\"\n                                android:textSize=\"10sp\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- Notice: kedaluwarsa -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_notice_danger\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"12dp\">\n\n                <FrameLayout\n                    android:layout_width=\"30dp\"\n                    android:layout_height=\"30dp\"\n                    android:background=\"@drawable/bg_ic_danger\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_alert_triangle\"\n                        app:tint=\"@color/sf_danger\" />\n                </FrameLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"10dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"1 batch kedaluwarsa perlu ditangani\"\n                        android:textColor=\"@color/sf_danger_ink\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"2dp\"\n                        android:text=\"Ultra Milk Full Cream 250ml · MLK-2411B · sisa 30 pcs\" />\n                </LinearLayout>\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginStart=\"8dp\"\n                    android:src=\"@drawable/ic_chevron_right\"\n                    app:tint=\"@color/sf_muted\" />\n            </LinearLayout>\n\n            <!-- Notice: stok menipis -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_notice_warn\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"12dp\">\n\n                <FrameLayout\n                    android:layout_width=\"30dp\"\n                    android:layout_height=\"30dp\"\n                    android:background=\"@drawable/bg_ic_warn\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_alert_circle\"\n                        app:tint=\"@color/sf_warn\" />\n                </FrameLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"10dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"2 barang di bawah stok minimum\"\n                        android:textColor=\"@color/sf_warn_ink\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"2dp\"\n                        android:text=\"Sunlight 755ml dan lainnya butuh restok.\" />\n                </LinearLayout>\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginStart=\"8dp\"\n                    android:src=\"@drawable/ic_chevron_right\"\n                    app:tint=\"@color/sf_muted\" />\n            </LinearLayout>\n\n            <!-- Metrik 2x2 -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginEnd=\"4dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_alert_circle\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Value\"\n                            android:text=\"2\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"4dp\"\n                            android:text=\"Stok menipis\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"4dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_clock\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Value\"\n                            android:text=\"3\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"4dp\"\n                            android:text=\"Mendekati kedaluwarsa\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"9dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginEnd=\"4dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_danger\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_alert_triangle\"\n                            app:tint=\"@color/sf_danger\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content