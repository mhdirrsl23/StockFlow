droid:layout_width=\"wrap_content\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:gravity=\"end\"\n                    android:orientation=\"vertical\"\n                    android:paddingTop=\"1dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                        android:text=\"+30\"\n                        android:textColor=\"@color/sf_safe\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"2dp\"\n                        android:text=\"07.34\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Lampiran -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Lampiran\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Tabel lampiran\" />\n            </LinearLayout>\n\n            <LinearLayout\n                style=\"@style/SF.Card\"\n                android:layout_marginTop=\"10dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Lampiran\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Muted\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"JPG/PNG maks 2 MB\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Outline\"\n                        android:text=\"0 file\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"72dp\"\n                    android:layout_height=\"76dp\"\n                    android:layout_marginTop=\"10dp\"\n                    android:background=\"@drawable/bg_attach_add\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center\"\n                    android:orientation=\"vertical\">\n\n                    <ImageView\n                        android:layout_width=\"16dp\"\n                        android:layout_height=\"16dp\"\n                        android:src=\"@drawable/ic_plus\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Tambah foto\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"8dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Di mockup ini nama file disimpan ke tabel lampiran; unggahan nyata ditangani Laravel.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Informasi batch -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Informasi batch\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Kolom tabel batch_stok\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"15dp\"\n                android:paddingVertical=\"2dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"ID batch\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Mono\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:fontFamily=\"monospace\"\n                        android:gravity=\"end\"\n                        android:text=\"#4\"\n                        android:textStyle=\"bold\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Nomor batch\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Mono\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:fontFamily=\"monospace\"\n                        android:gravity=\"end\"\n                        android:text=\"MLK-2411B\"\n                        android:textStyle=\"bold\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Barang\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Link\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                        android:gravity=\"end\"\n                        android:text=\"Ultra Milk Full Cream 250ml\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Jumlah awal\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"30 pcs\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Jumlah sisa\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"30 pcs\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Tanggal kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"29 Oktober 2026\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Status\" />\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Pill.Danger\"\n                            android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                            android:text=\"Kedaluwarsa\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Status penanganan\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"—\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Catatan penanganan\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"—\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Dibuat oleh\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"Rina Wulandari\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Dibuat pada\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"30 Okt 2026 · 07.34 WIB\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Deleted at\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"— (aktif)\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Catatan sumber -->\n            <TextView\n                style=\"@style/SF.Text.Caption\"\n                android:layout_marginTop=\"16dp\"\n                android:drawableStart=\"@drawable/ic12_database\"\n                android:drawablePadding=\"4dp\"\n                android:drawableTint=\"@color/sf_muted_2\"\n                android:gravity=\"center_vertical\"\n                android:paddingHorizontal=\"2dp\"\n                android:text=\"Sumber: batch_stok #4 · status dihitung dari ambang 30 hari\"\n                android:textColor=\"@color/sf_muted_2\" />\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Actionbar -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_marginEnd=\"4dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_swap_horiz\"\n            android:text=\"Sesuaikan\" />\n\n        <TextView\n            style=\"@style/SF.Btn.Danger\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"4dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_package_x\"\n            android:text=\"Tangani sekarang\" />\n    </LinearLayout>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 4,
                                    "endLine": 870,
                                    "snippet": {
                                        "text": "  Data contoh = seed stockflow_database.sql (30 Okt 2026). Tanpa tabbar; actionbar bawah.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:ellipsize=\"end\"\n            android:singleLine=\"true\"\n            android:text=\"Detail batch\"\n            android:textSize=\"18sp\" />\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_more_v\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Kartu status batch -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:background=\"@drawable/bg_card_tint\"\n                android:orientation=\"vertical\"\n                android:padding=\"15dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Eyebrow\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Status batch\" />\n\n                    <TextView\n                        style=\"@style/SF.Pill.Danger\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Kedaluwarsa\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"11dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_drink\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cup\"\n                            app:tint=\"#2C6B93\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:text=\"Ultra Milk Full Cream 250ml\" />\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"3dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Mono\"\n                                android:fontFamily=\"monospace\"\n                                android:text=\"MLK-2411B\"\n                                android:textStyle=\"bold\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:text=\" · SKU-MNM-001\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"13dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ProgressBar\n                        style=\"@style/SF.Progress.Danger\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"5dp\"\n                        android:layout_weight=\"1\"\n                        android:progress=\"100\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginStart=\"7dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"30/30\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"9dp\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Kedaluwarsa 1 hr lalu\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:text=\"29 Okt 2026\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Alert strip: perlu ditangani -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_alert_danger\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_alert_triangle\"\n                    app:tint=\"@color/sf_danger_ink\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Masuk daftar Perlu Ditangani.\"\n                        android:textColor=\"@color/sf_danger_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"2dp\"\n                        android:lineSpacingMultiplier=\"1.25\"\n                        android:text=\"Batch ini tidak dihitung sebagai stok tersedia. Tandai penanganannya agar audit tetap rapi.\"\n                        android:textColor=\"@color/sf_danger_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Ringkasan stok -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Ringkasan stok\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Nilai batch saat ini\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginEnd=\"3dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                        android:letterSpacing=\"-0.04\"\n                        android:text=\"30\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"18sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"4dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"sisa pcs\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginHorizontal=\"3dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_12\"\n                    android:orientation=\"vertical\"\n                    an