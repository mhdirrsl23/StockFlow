                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:ellipsize=\"end\"\n            android:singleLine=\"true\"\n            android:text=\"Notifikasi\"\n            android:textSize=\"18sp\" />\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_check_circle\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Ringkasan belum dibaca -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Eyebrow\"\n                        android:text=\"Notifikasi hari ini\" />\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"3dp\"\n                        android:gravity=\"bottom\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:letterSpacing=\"-0.03\"\n                            android:text=\"4\"\n                            android:textColor=\"@color/sf_ink\"\n                            android:textSize=\"26sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"5dp\"\n                            android:paddingBottom=\"3dp\"\n                            android:text=\"belum dibaca\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <FrameLayout\n                    android:layout_width=\"44dp\"\n                    android:layout_height=\"44dp\"\n                    android:background=\"@drawable/bg_ic_warn\">\n\n                    <ImageView\n                        android:layout_width=\"20dp\"\n                        android:layout_height=\"20dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_bell\"\n                        app:tint=\"@color/sf_warn\" />\n                </FrameLayout>\n            </LinearLayout>\n\n            <!-- Chip filter -->\n            <HorizontalScrollView\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:scrollbars=\"none\">\n\n                <LinearLayout\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"1dp\"\n                    android:paddingBottom=\"3dp\">\n\n                    <TextView\n                        style=\"@style/SF.Chip.Active\"\n                        android:text=\"Semua\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Mendekati\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Stok Menipis\" />\n                </LinearLayout>\n            </HorizontalScrollView>\n\n            <!-- 1 Mendekati — MGN-2411B -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_unread\">\n\n                <View\n                    android:layout_width=\"3dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_gravity=\"start\"\n                    android:layout_marginTop=\"12dp\"\n                    android:layout_marginBottom=\"12dp\"\n                    android:background=\"@drawable/bg_unread_accent\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"13dp\"\n                    android:paddingTop=\"11dp\"\n                    android:paddingEnd=\"11dp\"\n                    android:paddingBottom=\"11dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"36dp\"\n                        android:layout_height=\"36dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"16dp\"\n                            android:layout_height=\"16dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_clock\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"Mendekati Kedaluwarsa\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <View\n                                android:layout_width=\"6dp\"\n                                android:layout_height=\"6dp\"\n                                android:layout_marginStart=\"6dp\"\n                                android:background=\"@drawable/dot_brand\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"3dp\"\n                            android:lineSpacingMultiplier=\"1.45\"\n                            android:text=\"Batch MGN-2411B (Indomie Goreng) mendekati kedaluwarsa: 30 hari lagi.\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Warn\"\n                            android:layout_marginTop=\"5dp\"\n                            android:drawableStart=\"@drawable/ic12_clock\"\n                            android:text=\"Mendekati\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"7dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <ImageView\n                                android:layout_width=\"11dp\"\n                                android:layout_height=\"11dp\"\n                                android:src=\"@drawable/ic_clock\"\n                                app:tint=\"@color/sf_muted_2\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"30 Okt 2026 · 06.00 WIB\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Link\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginStart=\"8dp\"\n                                android:layout_weight=\"1\"\n                                android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                                android:gravity=\"end\"\n                                android:text=\"Lihat batch\"\n                                android:textSize=\"10sp\" />\n\n                            <ImageView\n                                android:layout_width=\"26dp\"\n                                android:layout_height=\"26dp\"\n                                android:layout_marginStart=\"7dp\"\n                                android:background=\"@drawable/bg_iconbtn_boxed\"\n                                android:clickable=\"true\"\n                                android:focusable=\"true\"\n                                android:padding=\"7dp\"\n                                android:src=\"@drawable/ic_check\"\n                                app:tint=\"@color/sf_muted\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- 2 Mendekati — MLK-2411A -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"8dp\"\n                android:background=\"@drawable/bg_card_unread\">\n\n                <View\n                    android:layout_width=\"3dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_gravity=\"start\"\n                    android:layout_marginTop=\"12dp\"\n                    android:layout_marginBottom=\"12dp\"\n                    android:background=\"@drawable/bg_unread_accent\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"13dp\"\n                    android:paddingTop=\"11dp\"\n                    android:paddingEnd=\"11dp\"\n                    android:paddingBottom=\"11dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"36dp\"\n                        android:layout_height=\"36dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"16dp\"\n                            android:layout_height=\"16dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_clock\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"Mendekati Kedaluwarsa\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <View\n                                android:layout_width=\"6dp\"\n                                android:layout_height=\"6dp\"\n                                android:layout_marginStart=\"6dp\"\n                                android:background=\"@drawable/dot_brand\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"3dp\"\n                            android:lineSpacingMultiplier=\"1.45\"\n                            android:text=\"Batch MLK-2411A (Ultra Milk 250ml) mendekati kedaluwarsa: 25 hari lagi.\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Warn\"\n                            android:layout_marginTop=\"5dp\"\n                            android:drawableStart=\"@drawable/ic12_clock\"\n                            android:text=\"Mendekati\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"7dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <ImageView\n                                android:layout_width=\"11dp\"\n                                android:layout_height=\"11dp\"\n                                android:src=\"@drawable/ic_clock\"\n                                app:tint=\"@color/sf_muted_2\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"30 Okt 2026 · 06.00 WIB\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Link\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginStart=\"8dp\"\n                                android:layout_weight=\"1\"\n                                android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                                android:gravity=\"end\"\n                                android:text=\"Lihat batch\"\n                                android:textSize=\"10sp\" />\n\n                            <ImageView\n                                android:layout_width=\"26dp\"\n                                android:layout_height=\"26dp\"\n                                android:layout_marginStart=\"7dp\"\n                                android:background=\"@drawable/bg_iconbtn_boxed\"\n                                android:clickable=\"true\"\n                                android:focusable=\"true\"\n                                android:padding=\"7dp\"\n                                android:src=\"@drawable/ic_check\"\n                                app:tint=\"@color/sf_muted\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- 3 Kedaluwarsa — MLK-2411B -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"8dp\"\n                android:background=\"@drawable/bg_card_unread\">\n\n                <View\n                    android:layout_width=\"3dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_gravity=\"start\"\n                    android:layout_marginTop=\"12dp\"\n                    android:layout_marginBottom=\"12dp\"\n                    android:background=\"@drawable/bg_unread_accent\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"13dp\"\n                    android:paddingTop=\"11dp\"\n                    android:paddingEnd=\"11dp\"\n                    android:paddingBottom=\"11dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"36dp\"\n                        android:layout_height=\"36dp\"\n                        android:background=\"@drawable/bg_ic_danger\">\n\n                        <ImageView\n                            android:layout_width=\"16dp\"\n                            android:layout_height=\"16dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_alert_triangle\"\n                            app:tint=\"@color/sf_danger\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"Kedaluwarsa\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <View\n                                android:layout_width=\"6dp\"\n                                android:layout_height=\"6dp\"\n                                android:layout_marginStart=\"6dp\"\n                                android:background=\"@drawable/dot_brand\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"3dp\"\n                            android:lineSpacingMultiplier=\"1.45\"\n                            android:text=\"Batch MLK-2411B (Ultra Milk 250ml) sudah kedaluwarsa. Perlu ditangani.\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Danger\"\n                            android:layout_marginTop=\"5dp\"\n                            android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                            android:text=\"Kedaluwarsa\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"7dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <ImageView\n                                android:layout_width=\"11dp\"\n                                android:layout_height=\"11dp\"\n                                android:src=\"@drawable/ic_clock\"\n                                app:tint=\"@color/sf_muted_2\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"30 Okt 2026 · 06.00 WIB\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Link\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginStart=\"8dp\"\n                                android:layout_weight=\"1\"\n                                android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                                android:gravity=\"end\"\n                                android:text=\"Lihat batch\"\n                                android:textSize=\"10sp\" />\n\n                            <ImageView\n                                android:layout_width=\"26dp\"\n                                android:layout_height=\"26dp\"\n                                android:layout_marginStart=\"7dp\"\n                                android:background=\"@drawable/bg_iconbtn_boxed\"\n                                android:clickable=\"true\"\n                                android:focusable=\"true\"\n                                android:padding=\"7dp\"\n                                android:src=\"@drawable/ic_check\"\n                                app:tint=\"@color/sf_muted\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- 4 Stok Menipis — Sunlight -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"8dp\"\n                android:background=\"@drawable/bg_card_unread\">\n\n                <View\n                    android:layout_width=\"3dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_gravity=\"start\"\n                    android:layout_marginTop=\"12dp\"\n                    android:layout_marginBottom=\"12dp\"\n                    android:background=\"@drawable/bg_unread_accent\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"13dp\"\n                    android:paddingTop=\"11dp\"\n                    android:paddingEnd=\"11dp\"\n                    android:paddingBottom=\"11dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"36dp\"\n                        android:layout_height=\"36dp\"\n                        android:background=\"@drawable/bg_ic_info\">\n\n                        <ImageView\n                            android:layout_width=\"16dp\"\n                            android:layout_height=\"16dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_alert_circle\"\n                            app:tint=\"@color/sf_info\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"Stok Menipis\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <View\n                                android:layout_width=\"6dp\"\n                                android:layout_height=\"6dp\"\n                                android:layout_marginStart=\"6dp\"\n                                android:background=\"@drawable/dot_brand\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"3dp\"\n                            android:lineSpacingMultiplier=\"1.45\"\n                            android:text=\"Stok Sunlight 755ml menipis: sisa 5 pcs, minimum 15 pcs.\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"7dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <ImageView\n                                android:layout_width=\"11dp\"\n                                android:layout_height=\"11dp\"\n                                android:src=\"@drawable/ic_clock\"\n                                app:tint=\"@color/sf_muted_2\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"30 Okt 2026 · 06.00 WIB\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Link\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginStart=\"8dp\"\n                                android:layout_weight=\"1\"\n                                android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                                android:gravity=\"end\"\n                                android:text=\"Lihat barang\"\n                                android:textSize=\"10sp\" />\n\n                            <ImageView\n                                android:layout_width=\"26dp\"\n                                android:layout_height=\"26dp\"\n                                android:layout_marginStart=\"7dp\"\n                                android:background=\"@drawable/bg_iconbtn_boxed\"\n                                android:clickable=\"true\"\n                                android:focusable=\"true\"\n                                android:padding=\"7dp\"\n                                android:src=\"@drawable/ic_check\"\n                                app:tint=\"@color/sf_muted\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- Info penjadwal -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_calendar_clock\"\n                    app:tint=\"@color/sf_info_ink\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Dibuat penjadwal Laravel.\"\n                        android:textColor=\"@color/sf_info_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"2dp\"\n                        android:lineSpacingMultiplier=\"1.35\"\n                        android:text=\"Pukul 06.00 &amp; 18.00 WIB, lalu dibaca WorkManager tiap 12 jam. Satu baris per jenis per batch/barang per hari.\"\n                        android:textColor=\"@color/sf_info_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Catatan sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"13dp\"\n                    android:layout_height=\"13dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"6dp\"\n                    android:text=\"Sumber: notifikasi · 4 baris · semua belum ditampilkan\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 5,
                                    "endLine": 718,
                                    "snippet": {
                                        "text": "  Tanpa tab bar (sub-halaman).\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:ellipsize=\"end\"\n            android:singleLine=\"true\"\n            android:text=\"Notifikasi\"\n            android:textSize=\"18sp\" />\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_check_circle\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Ringkasan belum dibaca -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Eyebrow\"\n                        android:text=\"Notifikasi hari ini\" />\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"3dp\"\n                        android:gravity=\"bottom\"\n                        android:orientation=\"horizontal\">\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:letterSpacing=\"-0.03\"\n                            android:text=\"4\"\n                            android:textColor=\"@color/sf_ink\"\n                            android:textSize=\"26sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginStart=\"5dp\"\n                            android:paddingBottom=\"3dp\"\n                            android:text=\"belum dibaca\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <FrameLayout\n                    android:layout_width=\"44dp\"\n                    android:layout_height=\"44dp\"\n                    android:background=\"@drawable/bg_ic_warn\">\n\n                    <ImageView\n                        android:layout_width=\"20dp\"\n                        android:layout_height=\"20dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_bell\"\n                        app:tint=\"@color/sf_warn\" />\n                </FrameLayout>\n            </LinearLayout>\n\n            <!-- Chip filter -->\n            <HorizontalScrollView\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:scrollbars=\"none\">\n\n                <LinearLayout\n                    android:layout_width=\"wrap_content\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"1dp\"\n                    android:paddingBottom=\"3dp\">\n\n                    <TextView\n                        style=\"@style/SF.Chip.Active\"\n                        android:text=\"Semua\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Mendekati\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Chip\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Stok Menipis\" />\n                </LinearLayout>\n            </HorizontalScrollView>\n\n            <!-- 1 Mendekati — MGN-2411B -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_unread\">\n\n                <View\n                    android:layout_width=\"3dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_gravity=\"start\"\n                    android:layout_marginTop=\"12dp\"\n                    android:layout_marginBottom=\"12dp\"\n                    android:background=\"@drawable/bg_unread_accent\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"13dp\"\n                    android:paddingTop=\"11dp\"\n                    android:paddingEnd=\"11dp\"\n                    android:paddingBottom=\"11dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"36dp\"\n                        android:layout_height=\"36dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"16dp\"\n                            android:layout_height=\"16dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_clock\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"Mendekati Kedaluwarsa\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <View\n                                android:layout_width=\"6dp\"\n                                android:layout_height=\"6dp\"\n                                android:layout_marginStart=\"6dp\"\n                                android:background=\"@drawable/dot_brand\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"3dp\"\n                            android:lineSpacingMultiplier=\"1.45\"\n                            android:text=\"Batch MGN-2411B (Indomie Goreng) mendekati kedaluwarsa: 30 hari lagi.\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Warn\"\n                            android:layout_marginTop=\"5dp\"\n                            android:drawableStart=\"@drawable/ic12_clock\"\n                            android:text=\"Mendekati\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"7dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <ImageView\n                                android:layout_width=\"11dp\"\n                                android:layout_height=\"11dp\"\n                                android:src=\"@drawable/ic_clock\"\n                                app:tint=\"@color/sf_muted_2\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"30 Okt 2026 · 06.00 WIB\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Link\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginStart=\"8dp\"\n                                android:layout_weight=\"1\"\n                                android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                                android:gravity=\"end\"\n                                android:text=\"Lihat batch\"\n                                android:textSize=\"10sp\" />\n\n                            <ImageView\n                                android:layout_width=\"26dp\"\n                                android:layout_height=\"26dp\"\n                                android:layout_marginStart=\"7dp\"\n                                android:background=\"@drawable/bg_iconbtn_boxed\"\n                                android:clickable=\"true\"\n                                android:focusable=\"true\"\n                                android:padding=\"7dp\"\n                                android:src=\"@drawable/ic_check\"\n                                app:tint=\"@color/sf_muted\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- 2 Mendekati — MLK-2411A -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"8dp\"\n                android:background=\"@drawable/bg_card_unread\">\n\n                <View\n                    android:layout_width=\"3dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_gravity=\"start\"\n                    android:layout_marginTop=\"12dp\"\n                    android:layout_marginBottom=\"12dp\"\n                    android:background=\"@drawable/bg_unread_accent\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"13dp\"\n                    android:paddingTop=\"11dp\"\n                    android:paddingEnd=\"11dp\"\n                    android:paddingBottom=\"11dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"36dp\"\n                        android:layout_height=\"36dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"16dp\"\n                            android:layout_height=\"16dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_clock\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"Mendekati Kedaluwarsa\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <View\n                                android:layout_width=\"6dp\"\n                                android:layout_height=\"6dp\"\n                                android:layout_marginStart=\"6dp\"\n                                android:background=\"@drawable/dot_brand\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"3dp\"\n                            android:lineSpacingMultiplier=\"1.45\"\n                            android:text=\"Batch MLK-2411A (Ultra Milk 250ml) mendekati kedaluwarsa: 25 hari lagi.\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Warn\"\n                            android:layout_marginTop=\"5dp\"\n                            android:drawableStart=\"@drawable/ic12_clock\"\n                            android:text=\"Mendekati\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"7dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <ImageView\n                                android:layout_width=\"11dp\"\n                                android:layout_height=\"11dp\"\n                                android:src=\"@drawable/ic_clock\"\n                                app:tint=\"@color/sf_muted_2\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"30 Okt 2026 · 06.00 WIB\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Link\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginStart=\"8dp\"\n                                android:layout_weight=\"1\"\n                                android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                                android:gravity=\"end\"\n                                android:text=\"Lihat batch\"\n                                android:textSize=\"10sp\" />\n\n                            <ImageView\n                                android:layout_width=\"26dp\"\n                                android:layout_height=\"26dp\"\n                                android:layout_marginStart=\"7dp\"\n                                android:background=\"@drawable/bg_iconbtn_boxed\"\n                                android:clickable=\"true\"\n                                android:focusable=\"true\"\n                                android:padding=\"7dp\"\n                                android:src=\"@drawable/ic_check\"\n                                app:tint=\"@color/sf_muted\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- 3 Kedaluwarsa — MLK-2411B -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"8dp\"\n                android:background=\"@drawable/bg_card_unread\">\n\n                <View\n                    android:layout_width=\"3dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_gravity=\"start\"\n                    android:layout_marginTop=\"12dp\"\n                    android:layout_marginBottom=\"12dp\"\n                    android:background=\"@drawable/bg_unread_accent\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"13dp\"\n                    android:paddingTop=\"11dp\"\n                    android:paddingEnd=\"11dp\"\n                    android:paddingBottom=\"11dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"36dp\"\n                        android:layout_height=\"36dp\"\n                        android:background=\"@drawable/bg_ic_danger\">\n\n                        <ImageView\n                            android:layout_width=\"16dp\"\n                            android:layout_height=\"16dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_alert_triangle\"\n                            app:tint=\"@color/sf_danger\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"Kedaluwarsa\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <View\n                                android:layout_width=\"6dp\"\n                                android:layout_height=\"6dp\"\n                                android:layout_marginStart=\"6dp\"\n                                android:background=\"@drawable/dot_brand\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"3dp\"\n                            android:lineSpacingMultiplier=\"1.45\"\n                            android:text=\"Batch MLK-2411B (Ultra Milk 250ml) sudah kedaluwarsa. Perlu ditangani.\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n\n                        <TextView\n                            style=\"@style/SF.Pill.Danger\"\n                            android:layout_marginTop=\"5dp\"\n                            android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                            android:text=\"Kedaluwarsa\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"7dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <ImageView\n                                android:layout_width=\"11dp\"\n                                android:layout_height=\"11dp\"\n                                android:src=\"@drawable/ic_clock\"\n                                app:tint=\"@color/sf_muted_2\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"30 Okt 2026 · 06.00 WIB\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Link\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginStart=\"8dp\"\n                                android:layout_weight=\"1\"\n                                android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                                android:gravity=\"end\"\n                                android:text=\"Lihat batch\"\n                                android:textSize=\"10sp\" />\n\n                            <ImageView\n                                android:layout_width=\"26dp\"\n                                android:layout_height=\"26dp\"\n                                android:layout_marginStart=\"7dp\"\n                                android:background=\"@drawable/bg_iconbtn_boxed\"\n                                android:clickable=\"true\"\n                                android:focusable=\"true\"\n                                android:padding=\"7dp\"\n                                android:src=\"@drawable/ic_check\"\n                                app:tint=\"@color/sf_muted\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- 4 Stok Menipis — Sunlight -->\n            <FrameLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"8dp\"\n                android:background=\"@drawable/bg_card_unread\">\n\n                <View\n                    android:layout_width=\"3dp\"\n                    android:layout_height=\"match_parent\"\n                    android:layout_gravity=\"start\"\n                    android:layout_marginTop=\"12dp\"\n                    android:layout_marginBottom=\"12dp\"\n                    android:background=\"@drawable/bg_unread_accent\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"13dp\"\n                    android:paddingTop=\"11dp\"\n                    android:paddingEnd=\"11dp\"\n                    android:paddingBottom=\"11dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"36dp\"\n                        android:layout_height=\"36dp\"\n                        android:background=\"@drawable/bg_ic_info\">\n\n                        <ImageView\n                            android:layout_width=\"16dp\"\n                            android:layout_height=\"16dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_alert_circle\"\n                            app:tint=\"@color/sf_info\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_weight=\"1\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"Stok Menipis\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"12sp\" />\n\n                            <View\n                                android:layout_width=\"6dp\"\n                                android:layout_height=\"6dp\"\n                                android:layout_marginStart=\"6dp\"\n                                android:background=\"@drawable/dot_brand\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:layout_marginTop=\"3dp\"\n                            android:lineSpacingMultiplier=\"1.45\"\n                            android:text=\"Stok Sunlight 755ml menipis: sisa 5 pcs, minimum 15 pcs.\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"11sp\" />\n\n                        <LinearLayout\n                            android:layout_width=\"match_parent\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"7dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <ImageView\n                                android:layout_width=\"11dp\"\n                                android:layout_height=\"11dp\"\n                                android:src=\"@drawable/ic_clock\"\n                                app:tint=\"@color/sf_muted_2\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginStart=\"3dp\"\n                                android:text=\"30 Okt 2026 · 06.00 WIB\"\n                                android:textSize=\"9sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Link\"\n                                android:layout_width=\"0dp\"\n                                android:layout_height=\"wrap_content\"\n                                android:layout_marginStart=\"8dp\"\n                                android:layout_weight=\"1\"\n                                android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                                android:gravity=\"end\"\n                                android:text=\"Lihat barang\"\n                                android:textSize=\"10sp\" />\n\n                            <ImageView\n                                android:layout_width=\"26dp\"\n                                android:layout_height=\"26dp\"\n                                android:layout_marginStart=\"7dp\"\n                                android:background=\"@drawable/bg_iconbtn_boxed\"\n                                android:clickable=\"true\"\n                                android:focusable=\"true\"\n                                android:padding=\"7dp\"\n                                android:src=\"@drawable/ic_check\"\n                                app:tint=\"@color/sf_muted\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </LinearLayout>\n            </FrameLayout>\n\n            <!-- Info penjadwal -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_calendar_clock\"\n                    app:tint=\"@color/sf_info_ink\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Dibuat penjadwal Laravel.\"\n                        android:textColor=\"@color/sf_info_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"2dp\"\n                        android:lineSpacingMultiplier=\"1.35\"\n                        android:text=\"Pukul 06.00 &amp; 18.00 WIB, lalu dibaca WorkManager tiap 12 jam. Satu baris per jenis per batch/barang per hari.\"\n                        android:textColor=\"@color/sf_info_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Catatan sumber -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"13dp\"\n                    android:layout_height=\"13dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginStart=\"6dp\"\n                    android:text=\"Sumber: notifikasi · 4 baris · semua belum ditampilkan\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n</LinearLayout>\n"
                                    }
                                }
                            }
                        }
