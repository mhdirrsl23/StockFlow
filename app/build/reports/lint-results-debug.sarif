oid:text=\"SKU-RMH-001\"\n                        android:textStyle=\"bold\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Kategori\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"Kebutuhan Rumah\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Satuan\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"pcs\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Stok minimum\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"15 pcs\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Dibuat oleh\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"Budi Santoso\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Dibuat pada\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"30 Okt 2026 · 07.13 WIB\" />\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\"\n                    android:paddingVertical=\"9dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"0.42\"\n                        android:text=\"Deleted at\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"18dp\"\n                        android:layout_weight=\"0.58\"\n                        android:gravity=\"end\"\n                        android:text=\"— (aktif)\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Catatan sumber -->\n            <TextView\n                style=\"@style/SF.Text.Caption\"\n                android:layout_marginTop=\"16dp\"\n                android:drawableStart=\"@drawable/ic12_database\"\n                android:drawablePadding=\"4dp\"\n                android:drawableTint=\"@color/sf_muted_2\"\n                android:gravity=\"center_vertical\"\n                android:paddingHorizontal=\"2dp\"\n                android:text=\"Sumber: barang #4 · view v_stok_tersedia\"\n                android:textColor=\"@color/sf_muted_2\" />\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Actionbar -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_marginEnd=\"4dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_arrow_up_right\"\n            android:text=\"Stok keluar\" />\n\n        <TextView\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"4dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_plus\"\n            android:text=\"Tambah batch\" />\n    </LinearLayout>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 4,
                                    "endLine": 825,
                                    "snippet": {
                                        "text": "  Data contoh = seed stockflow_database.sql (30 Okt 2026). Tanpa tabbar; actionbar bawah.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:ellipsize=\"end\"\n            android:singleLine=\"true\"\n            android:text=\"Detail barang\"\n            android:textSize=\"18sp\" />\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_more_v\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Detail hero -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"horizontal\">\n\n                <FrameLayout\n                    android:layout_width=\"52dp\"\n                    android:layout_height=\"52dp\"\n                    android:background=\"@drawable/bg_product_home\">\n\n                    <ImageView\n                        android:layout_width=\"25dp\"\n                        android:layout_height=\"25dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_droplet\"\n                        app:tint=\"#397A55\" />\n                </FrameLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"12dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Title\"\n                        android:lineSpacingMultiplier=\"1.05\"\n                        android:text=\"Sunlight 755ml\" />\n\n                    <androidx.constraintlayout.widget.ConstraintLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginTop=\"5dp\">\n\n                        <TextView\n                            android:id=\"@+id/meta_sku\"\n                            style=\"@style/SF.Text.Mono\"\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:text=\"SKU-RMH-001\"\n                            android:textColor=\"@color/sf_muted\"\n                            android:textSize=\"10sp\" />\n\n                        <TextView\n                            android:id=\"@+id/meta_dot1\"\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:text=\"·\" />\n\n                        <TextView\n                            android:id=\"@+id/meta_kategori\"\n                            style=\"@style/SF.Pill.Outline\"\n                            android:text=\"Kebutuhan Rumah\" />\n\n                        <TextView\n                            android:id=\"@+id/meta_dot2\"\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:text=\"·\" />\n\n                        <TextView\n                            android:id=\"@+id/meta_satuan\"\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:text=\"pcs\"\n                            android:textSize=\"11sp\" />\n\n                        <androidx.constraintlayout.helper.widget.Flow\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            app:constraint_referenced_ids=\"meta_sku,meta_dot1,meta_kategori,meta_dot2,meta_satuan\"\n                            app:flow_horizontalBias=\"0\"\n                            app:flow_horizontalGap=\"6dp\"\n                            app:flow_horizontalStyle=\"packed\"\n                            app:flow_verticalGap=\"5dp\"\n                            app:flow_wrapMode=\"chain\"\n                            app:layout_constraintEnd_toEndOf=\"parent\"\n                            app:layout_constraintStart_toStartOf=\"parent\"\n                            app:layout_constraintTop_toTopOf=\"parent\" />\n                    </androidx.constraintlayout.widget.ConstraintLayout>\n                </LinearLayout>\n\n                <ImageView\n                    style=\"@style/SF.IconBtn.Boxed\"\n                    android:layout_marginStart=\"12dp\"\n                    android:src=\"@drawable/ic_more_v\" />\n            </LinearLayout>\n\n            <!-- Alert strip: stok di bawah minimum -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_alert_warn\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"11dp\"\n                android:paddingVertical=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_alert_circle\"\n                    app:tint=\"@color/sf_warn_ink\" />\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"9dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Stok di bawah minimum.\"\n                        android:textColor=\"@color/sf_warn_ink\"\n                        android:textSize=\"11sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"2dp\"\n                        android:lineSpacingMultiplier=\"1.25\"\n                        android:text=\"Tersedia 5 pcs dari minimum 15 pcs. Segera catat stok masuk.\"\n                        android:textColor=\"@color/sf_warn_ink\"\n                        android:textSize=\"11sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Stock card -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_tint\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\">\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Eyebrow\"\n                            android:text=\"Stok tersedia\" />\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"5dp\"\n                            android:gravity=\"bottom\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:letterSpacing=\"-0.05\"\n                                android:text=\"5\"\n                                android:textColor=\"@color/sf_ink\"\n                                android:textSize=\"32sp\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Muted\"\n                                android:layout_marginStart=\"5dp\"\n                                android:layout_marginBottom=\"4dp\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                                android:text=\"pcs\" />\n                        </LinearLayout>\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"5dp\"\n                            android:text=\"Minimum 15 pcs\" />\n                    </LinearLayout>\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:layout_marginStart=\"10dp\"\n                        android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                        android:text=\"Stok Menipis\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"10dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ProgressBar\n                        style=\"@style/SF.Progress.Warn\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"5dp\"\n                        android:layout_weight=\"1\"\n                        android:progress=\"33\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginStart=\"7dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"5/15\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Text.Muted\"\n                    android:layout_marginTop=\"7dp\"\n                    android:text=\"1 batch menyumbang stok tersedia. Batch kedaluwarsa dan ditangani tidak dihitung.\" />\n            </LinearLayout>\n\n            <!-- Batch stok -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"bottom\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Section\"\n                        android:text=\"Batch stok\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"1 batch · urut FEFO\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Text.Link\"\n                    android:drawableEnd=\"@drawable/ic12_plus\"\n                    android:text=\"Tambah\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"15dp\"\n                android:paddingVertical=\"2dp\">\n\n                <LinearLayout style=\"@style/SF.Row\">\n\n                    <FrameLayout\n                        android:layout_width=\"38dp\"\n                        android:layout_height=\"38dp\"\n                        android:background=\"@drawable/bg_ic_mint\">\n\n                        <ImageView\n                            android:layout_width=\"18dp\"\n                            android:layout_height=\"18dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_layers\"\n                            app:tint=\"@color/sf_brand\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Mono\"\n                            android:fontFamily=\"monospace\"\n                            android:text=\"SUN-2412A\"\n                            android:textStyle=\"bold\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.RowSub\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"Sisa 5 / 24 pcs · exp 29 Des 2026\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Pill.Safe\"\n                            android:drawableStart=\"@drawable/ic12_check_circle\"\n                            android:text=\"Aman\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"60 hr lagi\" />\n                    </LinearLayout>\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_marginStart=\"10dp\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"@color/sf_chev\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Mutasi terbaru -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"bottom\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Section\"\n                        android:text=\"Mutasi terbaru\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"2 dari total 2 mutasi\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Text.Link\"\n                    android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                    android:text=\"Laporan\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <LinearLayout\n                style=\"@style/SF.Card\"\n                android:layout_marginTop=\"10dp\">\n\n                <!-- Keluar 19 pcs -->\n                <FrameLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\">\n\n                    <View\n                        android:layout_width=\"1dp\"\n                        android:layout_height=\"match_parent\"\n                        android:layout_marginStart=\"13dp\"\n                        android:layout_marginTop=\"27dp\"\n                        android:background=\"@color/sf_line\" />\n\n                    <LinearLayout\n                        android:layout_width=\"match_parent\"\n                        android:layout_height=\"wrap_content\"\n                        android:orientation=\"horizontal\"\n                        android:paddingBottom=\"13dp\">\n\n                        <FrameLayout\n                            android:layout_width=\"27dp\"\n                            android:layout_height=\"27dp\"\n                            android:background=\"@drawable/bg_ic_danger\">\n\n                            <ImageView\n                                android:layout_width=\"13dp\"\n                                android:layout_height=\"13dp\"\n                                android:layout_gravity=\"center\"\n                                android:src=\"@drawable/ic_arrow_up_right\"\n                                app:tint=\"@color/sf_danger\" />\n                        </FrameLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"0dp\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:layout_weight=\"1\"\n                            android:orientation=\"vertical\"\n                            android:paddingTop=\"1dp\">\n\n                            <TextView\n                                style=\"@style/SF.Text.Strong\"\n                                android:text=\"Keluar 19 pcs · SUN-2412A\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"Penjualan harian · Rina Wulandari\" />\n                        </LinearLayout>\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginStart=\"9dp\"\n                            android:gravity=\"end\"\n                            android:orientation=\"vertical\"\n                            android:paddingTop=\"1dp\">\n\n                            <TextView\n                                style=\"@style/SF.Text\"\n                                android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                                android:text=\"−19\"\n                                android:textColor=\"@color/sf_danger\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.Caption\"\n                                android:layout_marginTop=\"2dp\"\n                                android:text=\"10.12\" />\n                        </LinearLayout>\n                    </LinearLayout>\n                </FrameLayout>\n\n                <!-- Masuk 24 pcs -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:orientation=\"horizontal\">\n\n                    <FrameLayout\n                        android:layout_width=\"27dp\"\n                        android:layout_height=\"27dp\"\n                        android:background=\"@drawable/bg_ic_safe\">\n\n                        <ImageView\n                            android:layout_width=\"13dp\"\n                            android:layout_height=\"13dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_arrow_down_left\"\n                            app:tint=\"@color/sf_safe\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\"\n                        android:paddingTop=\"1dp\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Strong\"\n                            android:text=\"Masuk 24 pcs · SUN-2412A\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.RowSub\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"Stok awal · Rina Wulandari\" />\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\"\n                        android:paddingTop=\"1dp\">\n\n                        <TextView\n                            style=\"@style/SF.Text\"\n                            android:fontFamily=\"@font/plus_jakarta_sans_extrabold\"\n                            android:text=\"+24\"\n                            android:textColor=\"@color/sf_safe\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"2dp\"\n                            android:text=\"07.48\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Informasi barang -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Informasi barang\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Kolom tabel barang\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"15dp\"\n                android:paddingVertical=\"2dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap