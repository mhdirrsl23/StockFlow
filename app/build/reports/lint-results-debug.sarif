                                    "snippet": {
                                        "text": "<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            android:id=\"@+id/btn_back\"\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"12dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batch baru\"\n            android:textSize=\"18sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Form intro -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Title\"\n                    android:text=\"Batch baru\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Muted\"\n                    android:layout_marginTop=\"4dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Stok masuk dicatat sebagai batch dengan tanggal kedaluwarsa sendiri. Sistem membuat mutasi masuk dan riwayat aktivitas otomatis.\"\n                    android:textSize=\"12sp\" />\n            </LinearLayout>\n\n            <!-- Section: Barang -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_box\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Barang\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Pilih barang\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:id=\"@+id/select_barang\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"11dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:ellipsize=\"end\"\n                        android:singleLine=\"true\"\n                        android:text=\"Indomie Goreng · SKU-MKN-001\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"13sp\" />\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"8dp\"\n                        android:rotation=\"90\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"#799085\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Satu barang boleh punya banyak batch.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Section: Identitas batch -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_tag\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Identitas batch\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <!-- Nomor batch -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Nomor batch\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_semibold\"\n                        android:gravity=\"end\"\n                        android:text=\"Unik per barang\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_tag\"\n                        app:tint=\"#8EA096\" />\n\n                    <EditText\n                        android:id=\"@+id/et_nomor_batch\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:background=\"@null\"\n                        android:hint=\"Contoh: MGN-2412A\"\n                        android:includeFontPadding=\"false\"\n                        android:inputType=\"textCapCharacters\"\n                        android:maxLength=\"100\"\n                        android:paddingStart=\"8dp\"\n                        android:paddingTop=\"11dp\"\n                        android:paddingEnd=\"11dp\"\n                        android:paddingBottom=\"11dp\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textColorHint=\"#A1B0A8\"\n                        android:textSize=\"13sp\" />\n                </LinearLayout>\n\n                <!-- Jumlah awal -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Jumlah awal\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"42dp\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:id=\"@+id/btn_batch_minus\"\n                        android:layout_width=\"37dp\"\n                        android:layout_height=\"match_parent\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:paddingHorizontal=\"11.5dp\"\n                        android:paddingVertical=\"14dp\"\n                        android:src=\"@drawable/ic_minus\"\n                        app:tint=\"#486458\" />\n\n                    <EditText\n                        android:id=\"@+id/batch_jumlah\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"match_parent\"\n                        android:layout_weight=\"1\"\n                        android:background=\"@null\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"center\"\n                        android:includeFontPadding=\"false\"\n                        android:inputType=\"number\"\n                        android:padding=\"0dp\"\n                        android:text=\"10\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"14sp\" />\n\n                    <ImageView\n                        android:id=\"@+id/btn_batch_plus\"\n                        android:layout_width=\"37dp\"\n                        android:layout_height=\"match_parent\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:paddingHorizontal=\"11.5dp\"\n                        android:paddingVertical=\"14dp\"\n                        android:src=\"@drawable/ic_plus\"\n                        app:tint=\"#486458\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"jumlah_sisa diisi sama dengan jumlah_awal saat batch dibuat.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Section: Kedaluwarsa -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_calendar\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Tanggal kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:id=\"@+id/select_tanggal\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"11dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:text=\"29/11/2026\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"13sp\" />\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_calendar\"\n                        app:tint=\"#799085\" />\n                </LinearLayout>\n\n                <!-- Status preview -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:background=\"@drawable/bg_status_preview\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Status otomatis\" />\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:drawableStart=\"@drawable/ic12_clock\"\n                        android:text=\"Mendekati\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Ambang peringatan saat ini 30 hari. Batas atas persis di ambang dianggap Mendekati Kedaluwarsa.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Section: Lampiran bukti -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_image\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Lampiran bukti\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Opsional\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <LinearLayout\n                    android:id=\"@+id/btn_pilih_foto\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"44dp\"\n                    android:background=\"@drawable/bg_btn_ghost\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"16dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_upload\"\n                        app:tint=\"@color/sf_ghost_text\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"7dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Pilih foto batch\"\n                        android:textColor=\"@color/sf_ghost_text\"\n                        android:textSize=\"13sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"JPG/PNG maks 2 MB. Disimpan sebagai baris lampiran jenis bukti_batch.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Form note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:padding=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_clipboard_check\"\n                    app:tint=\"#35647E\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"6dp\"\n                    android:layout_weight=\"1\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Menyimpan batch akan menambah mutasi masuk sebesar jumlah awal dan mencatat riwayat tambah batch_stok.\"\n                    android:textColor=\"#35647E\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"wrap_content\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"10dp\"\n                    android:layout_height=\"10dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: tabel batch_stok + mutasi_stok · FEFO memakai tanggal_kedaluwarsa\"\n                    android:textColor=\"@color/sf_muted_2\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Actionbar -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            android:id=\"@+id/btn_batal\"\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batal\" />\n\n        <TextView\n            android:id=\"@+id/btn_simpan\"\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"8dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_save\"\n            android:text=\"Simpan batch\" />\n    </LinearLayout>\n</LinearLayout>"
                                    }
                                },
                                "contextRegion": {
                                    "startLine": 4,
                                    "endLine": 713,
                                    "snippet": {
                                        "text": "  Tanggal kedaluwarsa default = hari ini (Jum, 30 Okt 2026) + 30 hari = 29 Nov 2026 -> status Mendekati.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml,Autofill,LabelFor\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            android:id=\"@+id/btn_back\"\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <TextView\n            style=\"@style/SF.Text.Title\"\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"12dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batch baru\"\n            android:textSize=\"18sp\" />\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width=\"match_parent\"\n            android:layout_height=\"wrap_content\"\n            android:orientation=\"vertical\"\n            android:paddingStart=\"18dp\"\n            android:paddingTop=\"4dp\"\n            android:paddingEnd=\"18dp\"\n            android:paddingBottom=\"26dp\">\n\n            <!-- Form intro -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Title\"\n                    android:text=\"Batch baru\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Muted\"\n                    android:layout_marginTop=\"4dp\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Stok masuk dicatat sebagai batch dengan tanggal kedaluwarsa sendiri. Sistem membuat mutasi masuk dan riwayat aktivitas otomatis.\"\n                    android:textSize=\"12sp\" />\n            </LinearLayout>\n\n            <!-- Section: Barang -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_box\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Barang\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Pilih barang\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:id=\"@+id/select_barang\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"11dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:ellipsize=\"end\"\n                        android:singleLine=\"true\"\n                        android:text=\"Indomie Goreng · SKU-MKN-001\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"13sp\" />\n\n                    <ImageView\n                        android:layout_width=\"14dp\"\n                        android:layout_height=\"14dp\"\n                        android:layout_marginStart=\"8dp\"\n                        android:rotation=\"90\"\n                        android:src=\"@drawable/ic_chevron_right\"\n                        app:tint=\"#799085\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Satu barang boleh punya banyak batch.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Section: Identitas batch -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_tag\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Identitas batch\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <!-- Nomor batch -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Nomor batch\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_semibold\"\n                        android:gravity=\"end\"\n                        android:text=\"Unik per barang\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingStart=\"11dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_tag\"\n                        app:tint=\"#8EA096\" />\n\n                    <EditText\n                        android:id=\"@+id/et_nomor_batch\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:background=\"@null\"\n                        android:hint=\"Contoh: MGN-2412A\"\n                        android:includeFontPadding=\"false\"\n                        android:inputType=\"textCapCharacters\"\n                        android:maxLength=\"100\"\n                        android:paddingStart=\"8dp\"\n                        android:paddingTop=\"11dp\"\n                        android:paddingEnd=\"11dp\"\n                        android:paddingBottom=\"11dp\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textColorHint=\"#A1B0A8\"\n                        android:textSize=\"13sp\" />\n                </LinearLayout>\n\n                <!-- Jumlah awal -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Jumlah awal\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"42dp\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:id=\"@+id/btn_batch_minus\"\n                        android:layout_width=\"37dp\"\n                        android:layout_height=\"match_parent\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:paddingHorizontal=\"11.5dp\"\n                        android:paddingVertical=\"14dp\"\n                        android:src=\"@drawable/ic_minus\"\n                        app:tint=\"#486458\" />\n\n                    <EditText\n                        android:id=\"@+id/batch_jumlah\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"match_parent\"\n                        android:layout_weight=\"1\"\n                        android:background=\"@null\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"center\"\n                        android:includeFontPadding=\"false\"\n                        android:inputType=\"number\"\n                        android:padding=\"0dp\"\n                        android:text=\"10\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"14sp\" />\n\n                    <ImageView\n                        android:id=\"@+id/btn_batch_plus\"\n                        android:layout_width=\"37dp\"\n                        android:layout_height=\"match_parent\"\n                        android:clickable=\"true\"\n                        android:focusable=\"true\"\n                        android:paddingHorizontal=\"11.5dp\"\n                        android:paddingVertical=\"14dp\"\n                        android:src=\"@drawable/ic_plus\"\n                        app:tint=\"#486458\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"jumlah_sisa diisi sama dengan jumlah_awal saat batch dibuat.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Section: Kedaluwarsa -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_calendar\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Wajib\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Label\"\n                        android:text=\"Tanggal kedaluwarsa\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"4dp\"\n                        android:text=\"*\"\n                        android:textColor=\"@color/sf_danger\"\n                        android:textSize=\"12sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:id=\"@+id/select_tanggal\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"5dp\"\n                    android:background=\"@drawable/bg_input\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:minHeight=\"42dp\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"11dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:text=\"29/11/2026\"\n                        android:textColor=\"@color/sf_ink\"\n                        android:textSize=\"13sp\" />\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_calendar\"\n                        app:tint=\"#799085\" />\n                </LinearLayout>\n\n                <!-- Status preview -->\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:background=\"@drawable/bg_status_preview\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"10dp\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Muted\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:text=\"Status otomatis\" />\n\n                    <TextView\n                        style=\"@style/SF.Pill.Warn\"\n                        android:drawableStart=\"@drawable/ic12_clock\"\n                        android:text=\"Mendekati\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"Ambang peringatan saat ini 30 hari. Batas atas persis di ambang dianggap Mendekati Kedaluwarsa.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Section: Lampiran bukti -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_card_16\"\n                android:orientation=\"vertical\"\n                android:padding=\"14dp\">\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_image\"\n                        app:tint=\"@color/sf_brand\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Strong\"\n                        android:layout_marginStart=\"7dp\"\n                        android:text=\"Lampiran bukti\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_weight=\"1\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:gravity=\"end\"\n                        android:letterSpacing=\"0.07\"\n                        android:text=\"Opsional\"\n                        android:textAllCaps=\"true\"\n                        android:textColor=\"@color/sf_muted_2\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <View\n                    style=\"@style/SF.Divider\"\n                    android:layout_marginTop=\"11dp\"\n                    android:layout_marginBottom=\"12dp\" />\n\n                <LinearLayout\n                    android:id=\"@+id/btn_pilih_foto\"\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"44dp\"\n                    android:background=\"@drawable/bg_btn_ghost\"\n                    android:clickable=\"true\"\n                    android:focusable=\"true\"\n                    android:gravity=\"center_vertical\"\n                    android:orientation=\"horizontal\"\n                    android:paddingHorizontal=\"16dp\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:src=\"@drawable/ic_upload\"\n                        app:tint=\"@color/sf_ghost_text\" />\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginStart=\"7dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Pilih foto batch\"\n                        android:textColor=\"@color/sf_ghost_text\"\n                        android:textSize=\"13sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"match_parent\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginTop=\"12dp\"\n                    android:orientation=\"horizontal\">\n\n                    <ImageView\n                        android:layout_width=\"11dp\"\n                        android:layout_height=\"11dp\"\n                        android:layout_marginTop=\"1dp\"\n                        android:src=\"@drawable/ic_info\"\n                        app:tint=\"@color/sf_muted\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"4dp\"\n                        android:layout_weight=\"1\"\n                        android:lineSpacingMultiplier=\"1.2\"\n                        android:text=\"JPG/PNG maks 2 MB. Disimpan sebagai baris lampiran jenis bukti_batch.\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Form note -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"14dp\"\n                android:background=\"@drawable/bg_alert_info\"\n                android:orientation=\"horizontal\"\n                android:padding=\"10dp\">\n\n                <ImageView\n                    android:layout_width=\"12dp\"\n                    android:layout_height=\"12dp\"\n                    android:layout_marginTop=\"1dp\"\n                    android:src=\"@drawable/ic_clipboard_check\"\n                    app:tint=\"#35647E\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"6dp\"\n                    android:layout_weight=\"1\"\n                    android:lineSpacingMultiplier=\"1.3\"\n                    android:text=\"Menyimpan batch akan menambah mutasi masuk sebesar jumlah awal dan mencatat riwayat tambah batch_stok.\"\n                    android:textColor=\"#35647E\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <!-- Sumber -->\n            <LinearLayout\n                android:layout_width=\"wrap_content\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"2dp\">\n\n                <ImageView\n                    android:layout_width=\"10dp\"\n                    android:layout_height=\"10dp\"\n                    android:src=\"@drawable/ic_database\"\n                    app:tint=\"@color/sf_muted_2\" />\n\n                <TextView\n                    style=\"@style/SF.Text\"\n                    android:layout_marginStart=\"4dp\"\n                    android:text=\"Sumber: tabel batch_stok + mutasi_stok · FEFO memakai tanggal_kedaluwarsa\"\n                    android:textColor=\"@color/sf_muted_2\"\n                    android:textSize=\"10sp\" />\n            </LinearLayout>\n        </LinearLayout>\n    </ScrollView>\n\n    <!-- Actionbar -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_actionbar\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"16dp\"\n        android:paddingTop=\"10dp\"\n        android:paddingEnd=\"16dp\"\n        android:paddingBottom=\"11dp\">\n\n        <TextView\n            android:id=\"@+id/btn_batal\"\n            style=\"@style/SF.Btn.Ghost\"\n            android:layout_width=\"0dp\"\n            android:layout_weight=\"1\"\n            android:text=\"Batal\" />\n\n        <TextView\n            android:id=\"@+id/btn_simpan\"\n            style=\"@style/SF.Btn.Primary\"\n            android:layout_width=\"0dp\"\n            android:layout_marginStart=\"8dp\"\n            android:layout_weight=\"1\"\n            android:drawableStart=\"@drawable/ic12_save\"\n            android:text=\"Simpan batch\" />\n    </LinearLayout>\n</LinearLayout>\n"
                                    }
                                }
                            }
                        }
                    ],
                    "fixes": [
                    ],
                    "partialFingerprints": {
                        "sourceContext/v1": "0472b09c64e287d5"
                    }
                },
                {
                    "ruleId": "UnusedResources",
                    "ruleIndex": 12,
                    "message": {
