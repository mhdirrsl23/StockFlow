yout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginStart=\"8dp\"\n                    android:src=\"@drawable/ic_chevron_right\"\n                    app:tint=\"@color/sf_muted\" />\n            </LinearLayout>\n\n            <!-- Notice: stok menipis -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:background=\"@drawable/bg_notice_warn\"\n                android:clickable=\"true\"\n                android:focusable=\"true\"\n                android:gravity=\"center_vertical\"\n                android:orientation=\"horizontal\"\n                android:padding=\"12dp\">\n\n                <FrameLayout\n                    android:layout_width=\"30dp\"\n                    android:layout_height=\"30dp\"\n                    android:background=\"@drawable/bg_ic_warn\">\n\n                    <ImageView\n                        android:layout_width=\"15dp\"\n                        android:layout_height=\"15dp\"\n                        android:layout_gravity=\"center\"\n                        android:src=\"@drawable/ic_alert_circle\"\n                        app:tint=\"@color/sf_warn\" />\n                </FrameLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"10dp\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"2 barang di bawah stok minimum\"\n                        android:textColor=\"@color/sf_warn_ink\"\n                        android:textSize=\"12sp\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"2dp\"\n                        android:text=\"Sunlight 755ml dan lainnya butuh restok.\" />\n                </LinearLayout>\n\n                <ImageView\n                    android:layout_width=\"14dp\"\n                    android:layout_height=\"14dp\"\n                    android:layout_marginStart=\"8dp\"\n                    android:src=\"@drawable/ic_chevron_right\"\n                    app:tint=\"@color/sf_muted\" />\n            </LinearLayout>\n\n            <!-- Metrik 2x2 -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginEnd=\"4dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_alert_circle\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Value\"\n                            android:text=\"2\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"4dp\"\n                            android:text=\"Stok menipis\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"4dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_clock\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Value\"\n                            android:text=\"3\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"4dp\"\n                            android:text=\"Mendekati kedaluwarsa\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"9dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginEnd=\"4dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_danger\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_alert_triangle\"\n                            app:tint=\"@color/sf_danger\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Value\"\n                            android:text=\"1\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"4dp\"\n                            android:text=\"Kedaluwarsa\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_marginStart=\"4dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:orientation=\"horizontal\"\n                    android:padding=\"12dp\">\n\n                    <FrameLayout\n                        android:layout_width=\"32dp\"\n                        android:layout_height=\"32dp\"\n                        android:background=\"@drawable/bg_ic_info\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_layers\"\n                            app:tint=\"@color/sf_info\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"9dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.Value\"\n                            android:text=\"6\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"4dp\"\n                            android:text=\"Batch aktif\" />\n                    </LinearLayout>\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Aksi cepat -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"2dp\">\n\n                <TextView\n                    style=\"@style/SF.Text.Section\"\n                    android:text=\"Aksi cepat\" />\n\n                <TextView\n                    style=\"@style/SF.Text.Caption\"\n                    android:layout_marginTop=\"3dp\"\n                    android:text=\"Alur utama manajemen stok\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:orientation=\"horizontal\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"76dp\"\n                    android:layout_marginEnd=\"3dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:gravity=\"center\"\n                    android:orientation=\"vertical\">\n\n                    <FrameLayout\n                        android:layout_width=\"30dp\"\n                        android:layout_height=\"30dp\"\n                        android:background=\"@drawable/bg_ic_mint\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_arrow_down_left\"\n                            app:tint=\"@color/sf_brand\" />\n                    </FrameLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"6dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Stok masuk\"\n                        android:textColor=\"#385548\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"76dp\"\n                    android:layout_marginHorizontal=\"3dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:gravity=\"center\"\n                    android:orientation=\"vertical\">\n\n                    <FrameLayout\n                        android:layout_width=\"30dp\"\n                        android:layout_height=\"30dp\"\n                        android:background=\"@drawable/bg_ic_mint\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_arrow_up_right\"\n                            app:tint=\"@color/sf_brand\" />\n                    </FrameLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"6dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Stok keluar\"\n                        android:textColor=\"#385548\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"76dp\"\n                    android:layout_marginHorizontal=\"3dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:gravity=\"center\"\n                    android:orientation=\"vertical\">\n\n                    <FrameLayout\n                        android:layout_width=\"30dp\"\n                        android:layout_height=\"30dp\"\n                        android:background=\"@drawable/bg_ic_danger\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_package_x\"\n                            app:tint=\"@color/sf_danger\" />\n                    </FrameLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"6dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Tangani\"\n                        android:textColor=\"#385548\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"76dp\"\n                    android:layout_marginStart=\"3dp\"\n                    android:layout_weight=\"1\"\n                    android:background=\"@drawable/bg_card_14\"\n                    android:gravity=\"center\"\n                    android:orientation=\"vertical\">\n\n                    <FrameLayout\n                        android:layout_width=\"30dp\"\n                        android:layout_height=\"30dp\"\n                        android:background=\"@drawable/bg_ic_warn\">\n\n                        <ImageView\n                            android:layout_width=\"15dp\"\n                            android:layout_height=\"15dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_plus\"\n                            app:tint=\"@color/sf_warn\" />\n                    </FrameLayout>\n\n                    <TextView\n                        style=\"@style/SF.Text\"\n                        android:layout_marginTop=\"6dp\"\n                        android:fontFamily=\"@font/plus_jakarta_sans_bold\"\n                        android:text=\"Tambah\"\n                        android:textColor=\"#385548\"\n                        android:textSize=\"10sp\" />\n                </LinearLayout>\n            </LinearLayout>\n\n            <!-- Prioritas FEFO -->\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"16dp\"\n                android:gravity=\"bottom\"\n                android:orientation=\"horizontal\"\n                android:paddingHorizontal=\"2dp\">\n\n                <LinearLayout\n                    android:layout_width=\"0dp\"\n                    android:layout_height=\"wrap_content\"\n                    android:layout_weight=\"1\"\n                    android:orientation=\"vertical\">\n\n                    <TextView\n                        style=\"@style/SF.Text.Section\"\n                        android:text=\"Prioritas FEFO\" />\n\n                    <TextView\n                        style=\"@style/SF.Text.Caption\"\n                        android:layout_marginTop=\"3dp\"\n                        android:text=\"Kedaluwarsa terdekat lebih dulu\" />\n                </LinearLayout>\n\n                <TextView\n                    style=\"@style/SF.Text.Link\"\n                    android:drawableEnd=\"@drawable/ic12_chevron_right\"\n                    android:text=\"Semua batch\"\n                    android:textSize=\"11sp\" />\n            </LinearLayout>\n\n            <LinearLayout\n                android:layout_width=\"match_parent\"\n                android:layout_height=\"wrap_content\"\n                android:layout_marginTop=\"10dp\"\n                android:background=\"@drawable/bg_card\"\n                android:orientation=\"vertical\"\n                android:paddingHorizontal=\"15dp\"\n                android:paddingVertical=\"4dp\">\n\n                <!-- MLK-2411B -->\n                <LinearLayout\n                    style=\"@style/SF.Row\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_drink\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cup\"\n                            app:tint=\"#2C6B93\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:text=\"Ultra Milk Full Cream 250ml\" />\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"4dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.BatchCode\"\n                                android:text=\"MLK-2411B\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_marginStart=\"5dp\"\n                                android:text=\"sisa 30 pcs\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Pill.Danger\"\n                            android:drawableStart=\"@drawable/ic12_alert_triangle\"\n                            android:text=\"Kedaluwarsa\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"1 hr lalu\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- PRC-2410A -->\n                <LinearLayout\n                    style=\"@style/SF.Row\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_med\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_pill\"\n                            app:tint=\"#9D4D59\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:text=\"Paracetamol 500mg\" />\n\n                        <LinearLayout\n                            android:layout_width=\"wrap_content\"\n                            android:layout_height=\"wrap_content\"\n                            android:layout_marginTop=\"4dp\"\n                            android:gravity=\"center_vertical\"\n                            android:orientation=\"horizontal\">\n\n                            <TextView\n                                style=\"@style/SF.Text.BatchCode\"\n                                android:text=\"PRC-2410A\" />\n\n                            <TextView\n                                style=\"@style/SF.Text.RowSub\"\n                                android:layout_marginStart=\"5dp\"\n                                android:text=\"sisa 20 box\" />\n                        </LinearLayout>\n                    </LinearLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"wrap_content\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"8dp\"\n                        android:gravity=\"end\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Pill.Warn\"\n                            android:drawableStart=\"@drawable/ic12_clock\"\n                            android:text=\"Mendekati\" />\n\n                        <TextView\n                            style=\"@style/SF.Text.Caption\"\n                            android:layout_marginTop=\"3dp\"\n                            android:text=\"5 hr lagi\" />\n                    </LinearLayout>\n                </LinearLayout>\n\n                <View style=\"@style/SF.Divider\" />\n\n                <!-- MLK-2411A -->\n                <LinearLayout\n                    style=\"@style/SF.Row\">\n\n                    <FrameLayout\n                        android:layout_width=\"35dp\"\n                        android:layout_height=\"35dp\"\n                        android:background=\"@drawable/bg_product_drink\">\n\n                        <ImageView\n                            android:layout_width=\"17dp\"\n                            android:layout_height=\"17dp\"\n                            android:layout_gravity=\"center\"\n                            android:src=\"@drawable/ic_cup\"\n                            app:tint=\"#2C6B93\" />\n                    </FrameLayout>\n\n                    <LinearLayout\n                        android:layout_width=\"0dp\"\n                        android:layout_height=\"wrap_content\"\n                        android:layout_marginStart=\"10dp\"\n                        android:layout_weight=\"1\"\n                        android:orientation=\"vertical\">\n\n                        <TextView\n                            style=\"@style/SF.Text.RowTitle\"\n                            android:text=\"Ultra Milk Full Cream 250ml\" />\n\n                        <LinearLayout\n                            android:layou