                                    "snippet": {
                                        "text": "  Tidak ditemukan — draft.html notFoundPage(). Tanpa tabbar.\n-->\n<LinearLayout xmlns:android=\"http://schemas.android.com/apk/res/android\"\n    xmlns:app=\"http://schemas.android.com/apk/res-auto\"\n    xmlns:tools=\"http://schemas.android.com/tools\"\n    android:layout_width=\"match_parent\"\n    android:layout_height=\"match_parent\"\n    android:background=\"@color/sf_bg\"\n    android:orientation=\"vertical\"\n    tools:ignore=\"HardcodedText,ContentDescription,UseCompatTextViewDrawableXml\">\n\n    <!-- Topbar sub-halaman -->\n    <LinearLayout\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"wrap_content\"\n        android:background=\"@drawable/bg_topbar_sub\"\n        android:gravity=\"center_vertical\"\n        android:minHeight=\"62dp\"\n        android:orientation=\"horizontal\"\n        android:paddingStart=\"18dp\"\n        android:paddingTop=\"17dp\"\n        android:paddingEnd=\"18dp\"\n        android:paddingBottom=\"10dp\">\n\n        <ImageView\n            style=\"@style/SF.IconBtn.Boxed\"\n            android:src=\"@drawable/ic_arrow_left\" />\n\n        <LinearLayout\n            android:layout_width=\"0dp\"\n            android:layout_height=\"wrap_content\"\n            android:layout_marginStart=\"11dp\"\n            android:layout_weight=\"1\"\n            android:orientation=\"vertical\">\n\n            <TextView\n                style=\"@style/SF.Text.Title\"\n                android:ellipsize=\"end\"\n                android:singleLine=\"true\"\n                android:text=\"Tidak ditemukan\"\n                android:textSize=\"18sp\" />\n        </LinearLayout>\n    </LinearLayout>\n\n    <ScrollView\n        android:layout_width=\"match_parent\"\n        android:layout_height=\"0dp\"\n        android:layout_weight=\"1\"\n        android:fillViewport=\"true\"\n        android:scrollbars=\"none\">\n\n        <LinearLayout\n            android:layout_width