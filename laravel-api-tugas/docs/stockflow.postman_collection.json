						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"batch_id\": 4,\n  \"status_penanganan\": \"Dimusnahkan\",\n  \"jumlah\": 30,\n  \"catatan_penanganan\": \"dibuang sesuai SOP\"\n}"
