						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jenis\": \"masuk\",\n  \"barang_id\": 1,\n  \"batch_id\": 1,\n  \"jumlah\": 10\n}"
						},
						"url": "{{base_url}}/stock-transactions"
					}
				},
				{
					"name": "stok keluar FEFO (BR-03)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jenis\": \"keluar\",\n  \"barang_id\": 1,\n  \"jumlah\": 30,\n  \"catatan\": \"penjualan\"\n}"
						},
						"url": "{{base_url}}/stock-transactions"
					}
				},
				{
					"name": "penyesuaian (alasan wajib)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jenis\": \"penyesuaian\",\n  \"barang_id\": 1,\n  \"batch_id\": 1,\n  \"jumlah\": -3,\n  \"catatan\": \"rusak saat pengecekan\"\n}"
						},
						"url": "{{base_url}}/stock-transactions"
					}
