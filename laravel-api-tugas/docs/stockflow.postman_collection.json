{
	"info": {
		"name": "StockFlow API (PRD 9.4)",
		"description": "Koleksi endpoint API Sistem Pemantauan Stok Kedaluwarsa.\n\n1. Set variabel collection: base_url (default http://127.0.0.1:8010/api).\n2. Jalankan POST login (folder Auth) — skrip test otomatis menyimpan token ke variabel collection `token`.\n3. Semua request lain memakai Bearer {{token}}.\n\nFormat respons seragam: {success, message, data|errors} (PRD 9.5).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8010/api"
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{token}}",
				"type": "string"
			}
		]
	},
	"item": [
		{
			"name": "Auth (FR-02, FR-05)",
			"item": [
				{
					"name": "login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const body = pm.response.json();",
									"if (body.success && body.data && body.data.token) {",
									"    pm.collectionVariables.set('token', body.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"pemilik\",\n  \"password\": \"password\"\n}"
						},
						"url": "{{base_url}}/login"
					}
				},
				{
					"name": "me",
					"request": { "method": "GET", "url": "{{base_url}}/me" }
				},
				{
					"name": "logout",
					"request": { "method": "POST", "url": "{{base_url}}/logout" }
				},
				{
					"name": "daftar token",
					"request": { "method": "GET", "url": "{{base_url}}/tokens" }
				},
				{
					"name": "hapus token",
					"request": {
						"method": "DELETE",
						"url": "{{base_url}}/tokens/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				},
				{
					"name": "cabut token lain",
					"request": { "method": "DELETE", "url": "{{base_url}}/tokens/others" }
				}
			]
		},
		{
			"name": "Dashboard (FR-03)",
			"item": [
				{
					"name": "dashboard",
					"request": { "method": "GET", "url": "{{base_url}}/dashboard" }
				}
			]
		},
		{
			"name": "Barang (FR-04, FR-17)",
			"item": [
				{
					"name": "daftar barang",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/products?q=&kategori=&per_page=15",
							"host": [ "{{base_url}}" ],
							"path": [ "products" ],
							"query": [
								{ "key": "q", "value": "" },
								{ "key": "kategori", "value": "" },
								{ "key": "per_page", "value": "15" }
							]
						}
					}
				},
				{
					"name": "detail barang",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/products/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				},
				{
					"name": "tambah barang",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"kode_sku\": \"SKU-MKN-099\",\n  \"nama\": \"Roti Tawar\",\n  \"kategori\": \"Makanan\",\n  \"satuan\": \"pcs\",\n  \"stok_minimum\": 20\n}"
						},
						"url": "{{base_url}}/products"
					}
				},
				{
					"name": "ubah barang",
					"request": {
						"method": "PUT",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nama\": \"Roti Tawar Gandum\",\n  \"stok_minimum\": 15\n}"
						},
						"url": "{{base_url}}/products/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				},
				{
					"name": "hapus barang",
					"request": {
						"method": "DELETE",
						"url": "{{base_url}}/products/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				},
				{
					"name": "hapus massal barang",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": { "mode": "raw", "raw": "{\n  \"ids\": [1, 2]\n}" },
						"url": "{{base_url}}/products/bulk-delete"
					}
				}
			]
		},
		{
			"name": "Batch stok (FR-05, FR-12)",
			"item": [
				{
					"name": "daftar batch (FEFO, filter status)",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/batches?barang_id=&status=&dari=&sampai=&per_page=20",
							"host": [ "{{base_url}}" ],
							"path": [ "batches" ],
							"query": [
								{ "key": "barang_id", "value": "" },
								{ "key": "status", "value": "" },
								{ "key": "dari", "value": "" },
								{ "key": "sampai", "value": "" },
								{ "key": "per_page", "value": "20" }
							]
						}
					}
				},
				{
					"name": "batch per barang",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/products/:barangId/batches",
						"variable": [ { "key": "barangId", "value": "1" } ]
					}
				},
				{
					"name": "tambah batch ke barang",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nomor_batch\": \"BCH-001\",\n  \"jumlah_awal\": 50,\n  \"tanggal_kedaluwarsa\": \"2027-01-31\"\n}"
						},
						"url": "{{base_url}}/products/:barangId/batches",
						"variable": [ { "key": "barangId", "value": "1" } ]
					}
				},
				{
					"name": "detail batch",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/batches/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				},
				{
					"name": "ubah karakteristik batch (BR-01)",
					"request": {
						"method": "PUT",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nomor_batch\": \"BCH-001\",\n  \"tanggal_kedaluwarsa\": \"2027-02-15\"\n}"
						},
						"url": "{{base_url}}/batches/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				},
				{
					"name": "hapus batch",
					"request": {
						"method": "DELETE",
						"url": "{{base_url}}/batches/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				},
				{
					"name": "hapus massal batch",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": { "mode": "raw", "raw": "{\n  \"ids\": [1]\n}" },
						"url": "{{base_url}}/batches/bulk-delete"
					}
				}
			]
		},
		{
			"name": "Transaksi stok (FR-06, FR-07, FR-13)",
			"item": [
