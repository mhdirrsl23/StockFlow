								{ "key": "jenis", "value": "" },
								{ "key": "barang_id", "value": "" },
								{ "key": "batch_id", "value": "" },
								{ "key": "dari", "value": "" },
								{ "key": "sampai", "value": "" },
								{ "key": "per_page", "value": "20" }
							]
						}
					}
				},
				{
					"name": "stok masuk (batch baru)",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jenis\": \"masuk\",\n  \"barang_id\": 1,\n  \"nomor_batch\": \"BCH-IN-1\",\n  \"tanggal_kedaluwarsa\": \"2027-03-01\",\n  \"jumlah\": 40,\n  \"catatan\": \"penerimaan PO\"\n}"
						},
