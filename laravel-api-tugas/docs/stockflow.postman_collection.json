					"name": "monitoring kedaluwarsa",
					"request": { "method": "GET", "url": "{{base_url}}/expiry-monitoring" }
				},
				{
					"name": "perlu ditangani",
					"request": { "method": "GET", "url": "{{base_url}}/expiry-monitoring/perlu-ditangani" }
				},
				{
					"name": "rekomendasi FEFO barang",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/products/:barangId/fefo",
						"variable": [ { "key": "barangId", "value": "1" } ]
					}
				}
			]
		},
		{
			"name": "Lampiran (FR-14)",
			"item": [
				{
					"name": "unggah bukti batch",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "jenis", "value": "bukti_batch", "type": "text" },
								{ "key": "lampiran", "type": "file", "src": [] }
							]
						},
						"url": "{{base_url}}/batches/:batchId/attachments",
						"variable": [ { "key": "batchId", "value": "1" } ],
						"description": "Pilih file JPG/PNG pada key `lampiran`. Batas ukuran mengikuti pengaturan `maks_ukuran_lampiran_mb`."
					}
				},
				{
					"name": "unduh lampiran",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/attachments/:id/file",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				},
				{
					"name": "hapus lampiran",
					"request": {
						"method": "DELETE",
						"url": "{{base_url}}/attachments/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				}
			]
		},
		{
			"name": "Impor barang (FR-15)",
			"item": [
				{
					"name": "pratinjau xlsx",
					"request": {
						"method": "POST",
						"body": {
							"mode": "formdata",
							"formdata": [
								{ "key": "berkas", "type": "file", "src": [] }
							]
						},
						"url": "{{base_url}}/imports/products/preview",
						"description": "File .xlsx/.xls dengan header: kode_sku, nama, kategori, satuan, stok_minimum. Respons menyimpan id + token konfirmasi (30 menit)."
					}
				},
				{
					"name": "konfirmasi impor",
					"request": {
						"method": "POST",
						"header": [ { "key": "Content-Type", "value": "application/json" } ],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": 1,\n  \"token\": \"<token-dari-pratinjau>\"\n}"
						},
						"url": "{{base_url}}/imports/products/commit"
					}
				},
				{
					"name": "riwayat impor",
					"request": { "method": "GET", "url": "{{base_url}}/imports" }
				},
				{
					"name": "detail impor",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/imports/:id",
						"variable": [ { "key": "id", "value": "1" } ]
					}
				}
			]
		},
		{
